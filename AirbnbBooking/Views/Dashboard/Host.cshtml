@model HostDashboardViewModel
@inject Helper Helper
@using System.Text.Json
@{
    ViewData["Title"] = "Host Analytics Dashboard";
}
<div class="container-xl py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <span class="sn-eyebrow">Module 7 · Host Analytics &amp; Reporting</span>
            <h2 class="fw-bold mt-1 mb-0">Host Performance Dashboard</h2>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <select id="hostRangeSel" class="form-select form-select-sm" style="width:auto">
                <option value="30" selected="@(Model.RangeDays == 30)">Last 30 Days</option>
                <option value="90" selected="@(Model.RangeDays == 90)">Last 90 Days</option>
                <option value="180" selected="@(Model.RangeDays == 180)">Last 180 Days</option>
                <option value="365" selected="@(Model.RangeDays == 365)">Last 12 Months</option>
            </select>
            <a asp-action="ExportHostReportCsv" class="btn sn-btn-dark btn-sm"><i class="bi bi-download me-1"></i>CSV Report</a>
            <button type="button" onclick="window.print()" class="btn sn-btn-ghost btn-sm no-print"><i class="bi bi-printer me-1"></i>Print PDF</button>
        </div>
    </div>

    <!-- KPI Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="sn-kpi">
                <div class="d-flex justify-content-between"><span class="small text-muted">Occupancy Rate</span><span class="sn-kpi-icon"><i class="bi bi-calendar-check"></i></span></div>
                <div class="fs-3 fw-bold mt-2" id="kpiOcc">@Model.OccupancyRatePercent%</div>
                <div class="small text-muted">@Model.ActiveListings/@Model.TotalListings active listings</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="sn-kpi">
                <div class="d-flex justify-content-between"><span class="small text-muted">Net Host Earnings</span><span class="sn-kpi-icon"><i class="bi bi-cash-coin"></i></span></div>
                <div class="fs-3 fw-bold mt-2 text-success">@Helper.FormatMoney(Model.TotalNetPayouts)</div>
                <div class="small text-muted">Pending payout: @Helper.FormatMoney(Model.PendingPayoutAmount)</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="sn-kpi">
                <div class="d-flex justify-content-between"><span class="small text-muted">Total Reservations</span><span class="sn-kpi-icon"><i class="bi bi-suitcase-lg"></i></span></div>
                <div class="fs-3 fw-bold mt-2">@Model.TotalBookings</div>
                <div class="small text-muted">@Model.ActiveStaysCount guest(s) currently checked in</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="sn-kpi">
                <div class="d-flex justify-content-between"><span class="small text-muted">Reputation Score</span><span class="sn-kpi-icon"><i class="bi bi-star-fill"></i></span></div>
                <div class="fs-3 fw-bold mt-2">★ @(Model.AverageHostRating > 0 ? Model.AverageHostRating.ToString("0.00") : "N/A")</div>
                <div class="small text-muted">@Model.OpenServiceRequests open service request(s)</div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="sn-card p-4 h-100">
                <h5 class="fw-bold mb-3">Monthly Earnings &amp; Booking Volume (6 Months)</h5>
                <canvas id="hostEarningsChart" height="115"></canvas>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="sn-card p-4 h-100">
                <h5 class="fw-bold mb-3">Booking Status Mix</h5>
                <canvas id="hostStatusChart" height="210"></canvas>
            </div>
        </div>
    </div>

    <!-- Recent Bookings -->
    <div class="sn-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Recent Reservations</h5>
            <a asp-controller="Booking" asp-action="HostBookings" class="small text-decoration-none fw-semibold" style="color:var(--sn-accent)">View All →</a>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="small text-muted">
                    <tr><th>Ref</th><th>Property</th><th>Guest</th><th>Dates</th><th>Total</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.RecentBookings)
                    {
                        <tr>
                            <td class="font-monospace small"><a asp-controller="Booking" asp-action="Details" asp-route-id="@b.Id">@b.BookingReference</a></td>
                            <td class="small fw-semibold">@b.Property.Title</td>
                            <td class="small">@b.Guest.FullName</td>
                            <td class="small">@b.CheckInDate.ToString("dd MMM") – @b.CheckOutDate.ToString("dd MMM")</td>
                            <td class="small fw-bold">@Helper.FormatMoney(b.TotalAmount)</td>
                            <td><span class="sn-status sn-status-@b.Status">@b.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const earnChart = new Chart(document.getElementById('hostEarningsChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.ChartLabels)),
                datasets: [
                    {
                        label: 'Net Earnings (MYR)',
                        data: @Html.Raw(JsonSerializer.Serialize(Model.MonthlyEarnings)),
                        backgroundColor: 'rgba(255, 56, 92, 0.82)',
                        borderRadius: 8
                    },
                    {
                        label: 'Bookings',
                        type: 'line',
                        yAxisID: 'y1',
                        data: @Html.Raw(JsonSerializer.Serialize(Model.MonthlyBookingCounts)),
                        borderColor: '#111827',
                        tension: 0.35
                    }
                ]
            },
            options: {
                responsive: true,
                scales: {
                    y: { beginAtZero: true },
                    y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false }, ticks: { stepSize: 1 } }
                }
            }
        });

        const statusDist = @Html.Raw(JsonSerializer.Serialize(Model.StatusDistribution));
        const statusChart = new Chart(document.getElementById('hostStatusChart'), {
            type: 'doughnut',
            data: {
                labels: Object.keys(statusDist),
                datasets: [{
                    data: Object.values(statusDist),
                    backgroundColor: ['#f59e0b', '#3b82f6', '#10b981', '#8b5cf6', '#ef4444']
                }]
            },
            options: { plugins: { legend: { position: 'bottom' } } }
        });

        // AJAX Range Selector Refresh
        document.getElementById('hostRangeSel')?.addEventListener('change', async e => {
            const res = await fetch(`/Dashboard/HostChartData?rangeDays=${e.target.value}`);
            const data = await res.json();
            document.getElementById('kpiOcc').textContent = data.occupancyRate + '%';
            earnChart.data.labels = data.labels;
            earnChart.data.datasets[0].data = data.earnings;
            earnChart.data.datasets[1].data = data.bookings;
            earnChart.update();
        });
    </script>
}
