@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}
<div class="container-xl py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="sn-card p-4 p-md-5">
                <span class="sn-eyebrow">Security</span>
                <h2 class="fw-bold mt-2 mb-3">Choose a new password</h2>
                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Token" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label small fw-semibold"></label>
                        <input asp-for="NewPassword" class="form-control" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn sn-btn-primary w-100 py-2">Save New Password</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
