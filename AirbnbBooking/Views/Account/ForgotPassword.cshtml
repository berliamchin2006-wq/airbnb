@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}
<div class="container-xl py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="sn-card p-4 p-md-5">
                <span class="sn-eyebrow">Password Recovery</span>
                <h2 class="fw-bold mt-2 mb-1">Reset your password</h2>
                <p class="text-muted small mb-4">We will email you a secure one-hour token link via Gmail SMTP.</p>

                @if (TempData["DemoResetUrl"] != null)
                {
                    <div class="alert sn-alert sn-alert-info small">
                        <strong>SMTP Fallback Reset Link:</strong><br />
                        <a href="@TempData["DemoResetUrl"]" class="text-break">@TempData["DemoResetUrl"]</a>
                    </div>
                }

                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label small fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="you@staynest.my" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn sn-btn-primary w-100 py-2">Send Reset Link</button>
                </form>
                <div class="text-center mt-3">
                    <a asp-action="Login" class="small text-muted text-decoration-none">Back to Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
