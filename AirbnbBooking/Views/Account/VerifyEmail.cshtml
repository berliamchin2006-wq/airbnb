@model VerifyEmailViewModel
@{
    ViewData["Title"] = "Verify Email";
}
<div class="container-xl py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="sn-card p-4 p-md-5">
                <span class="sn-eyebrow">Email Verification</span>
                <h2 class="fw-bold mt-2 mb-1">Activate your account</h2>
                <p class="text-muted small mb-4">Enter the 6-digit OTP emailed to your inbox (valid for 15 minutes).</p>

                @if (TempData["DemoOtp"] != null)
                {
                    <div class="alert sn-alert sn-alert-info">
                        <strong>Local Demo OTP:</strong> <code class="fs-5">@TempData["DemoOtp"]</code>
                    </div>
                }

                <form asp-action="VerifyEmail" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Code" class="form-label small fw-semibold"></label>
                        <input asp-for="Code" class="form-control form-control-lg text-center font-monospace" placeholder="123456" maxlength="6" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn sn-btn-primary w-100 py-2">Verify &amp; Activate</button>
                </form>

                <form asp-action="ResendOtp" method="post" class="mt-3 text-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@Model.Email" />
                    <button type="submit" class="btn btn-link small text-decoration-none">Didn't receive the email? Resend OTP</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
