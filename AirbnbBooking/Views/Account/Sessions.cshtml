@model List<UserSessionToken>
@{
    ViewData["Title"] = "Active Rotating Sessions";
}
<div class="container-xl py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="sn-eyebrow">Module 1 · Token Rotation</span>
            <h2 class="fw-bold mt-1 mb-0">Active Device Sessions</h2>
        </div>
        <a asp-action="Profile" class="btn sn-btn-ghost btn-sm">Back to Profile</a>
    </div>

    <div class="sn-card p-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="small text-muted">
                    <tr>
                        <th>Token Hash (SHA-256)</th>
                        <th>Device / Agent</th>
                        <th>IP Address</th>
                        <th>Issued</th>
                        <th>Expires</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        bool active = !s.IsRevoked && s.ExpiresAt > DateTime.Now;
                        <tr>
                            <td class="font-monospace small">@s.TokenHash[..14]…</td>
                            <td class="small text-truncate" style="max-width:260px">@s.DeviceInfo</td>
                            <td class="small">@s.IpAddress</td>
                            <td class="small">@s.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="small">@s.ExpiresAt.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (active)
                                {
                                    <span class="sn-status sn-status-Verified">Active</span>
                                }
                                else if (!string.IsNullOrEmpty(s.ReplacedByTokenHash))
                                {
                                    <span class="sn-status sn-status-Confirmed">Rotated</span>
                                }
                                else
                                {
                                    <span class="sn-status sn-status-Cancelled">Revoked</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (active)
                                {
                                    <form asp-action="RevokeSession" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@s.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
