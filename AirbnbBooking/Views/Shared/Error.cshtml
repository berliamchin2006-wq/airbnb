@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="container-xl py-5">
    <div class="sn-card p-5 text-center mx-auto" style="max-width:560px">
        <div class="display-4 text-danger mb-3"><i class="bi bi-exclamation-octagon"></i></div>
        <h2 class="fw-bold mb-2">Something went wrong</h2>
        <p class="text-muted">An unexpected error occurred while processing your request.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Property" asp-action="Catalog" class="btn sn-btn-primary mt-2">Back to Explore</a>
    </div>
</div>
