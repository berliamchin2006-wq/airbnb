@inject Helper Helper
@{
    var theme = Context.Request.Cookies["StayNest_Theme"] ?? "light";
    var currency = Context.Request.Cookies["StayNest_Currency"] ?? "MYR";
    bool isAuth = User.Identity?.IsAuthenticated == true;
    string role = Helper.GetCurrentUserRole();
    string fullName = Helper.GetCurrentUserFullName();
    string ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ff385c" />
    <title>@ViewData["Title"] — StayNest Airbnb</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5.3 + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Leaflet Maps -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <!-- Custom StayNest Editorial Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="sn-header sticky-top">
        <nav class="navbar navbar-expand-lg sn-navbar">
            <div class="container-xl">
                <a class="sn-brand" asp-controller="Property" asp-action="Catalog">
                    <span class="sn-brand-mark"><i class="bi bi-house-heart-fill"></i></span>
                    <span class="sn-brand-word">StayNest</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link sn-nav-link @(ctrl == "Property" && act == "Catalog" ? "active" : "")" asp-controller="Property" asp-action="Catalog">
                                <i class="bi bi-compass me-1"></i>Explore
                            </a>
                        </li>

                        @if (isAuth)
                        {
                            <li class="nav-item">
                                <a class="nav-link sn-nav-link @(ctrl == "Booking" && act == "MyTrips" ? "active" : "")" asp-controller="Booking" asp-action="MyTrips">
                                    <i class="bi bi-suitcase-lg me-1"></i>Trips
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sn-nav-link @(ctrl == "Property" && act == "Wishlist" ? "active" : "")" asp-controller="Property" asp-action="Wishlist">
                                    <i class="bi bi-heart me-1"></i>Wishlist
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sn-nav-link @(ctrl == "Stay" ? "active" : "")" asp-controller="Stay" asp-action="Index">
                                    <i class="bi bi-door-open me-1"></i>In-Stay
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sn-nav-link @(ctrl == "Review" ? "active" : "")" asp-controller="Review" asp-action="Pending">
                                    <i class="bi bi-star me-1"></i>Reviews
                                </a>
                            </li>
                        }

                        @if (role is "Host" or "Admin")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link sn-nav-link dropdown-toggle @(ctrl == "Dashboard" && act == "Host" || act == "MyProperties" || act == "HostBookings" || act == "HostPayouts" ? "active" : "")" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-building-gear me-1"></i>Host Hub
                                </a>
                                <ul class="dropdown-menu sn-dropdown">
                                    <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Host"><i class="bi bi-graph-up-arrow me-2"></i>Host Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Property" asp-action="MyProperties"><i class="bi bi-houses me-2"></i>My Listings</a></li>
                                    <li><a class="dropdown-item" asp-controller="Property" asp-action="Create"><i class="bi bi-plus-circle me-2"></i>Add New Listing</a></li>
                                    <li><a class="dropdown-item" asp-controller="Booking" asp-action="HostBookings"><i class="bi bi-calendar2-check me-2"></i>Reservations</a></li>
                                    <li><a class="dropdown-item" asp-controller="Payment" asp-action="HostPayouts"><i class="bi bi-wallet2 me-2"></i>Payout Ledger</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Stay" asp-action="QrScanner"><i class="bi bi-qr-code-scan me-2"></i>QR Check-In Scanner</a></li>
                                    <li><a class="dropdown-item" asp-controller="Stay" asp-action="ServiceRequests"><i class="bi bi-tools me-2"></i>Service Requests</a></li>
                                </ul>
                            </li>
                        }

                        @if (role == "Admin")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link sn-nav-link dropdown-toggle @(ctrl == "Security" || (ctrl == "Dashboard" && act == "Admin") || act == "Transactions" ? "active" : "")" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-shield-lock me-1"></i>Admin
                                </a>
                                <ul class="dropdown-menu sn-dropdown">
                                    <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Admin"><i class="bi bi-speedometer2 me-2"></i>Platform Analytics</a></li>
                                    <li><a class="dropdown-item" asp-controller="Security" asp-action="Users"><i class="bi bi-people me-2"></i>Users &amp; ID Verification</a></li>
                                    <li><a class="dropdown-item" asp-controller="Security" asp-action="Listings"><i class="bi bi-building-check me-2"></i>Listing Moderation</a></li>
                                    <li><a class="dropdown-item" asp-controller="Payment" asp-action="Transactions"><i class="bi bi-cash-stack me-2"></i>Transactions &amp; Payouts</a></li>
                                    <li><a class="dropdown-item" asp-controller="Security" asp-action="PromoCodes"><i class="bi bi-ticket-perforated me-2"></i>Promo Codes</a></li>
                                    <li><a class="dropdown-item" asp-controller="Security" asp-action="Disputes"><i class="bi bi-exclamation-octagon me-2"></i>Disputes &amp; Moderation</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Security" asp-action="AuditLogs"><i class="bi bi-journal-text me-2"></i>Audit Log Explorer</a></li>
                                    <li><a class="dropdown-item" asp-controller="Security" asp-action="SystemHealth"><i class="bi bi-cpu me-2"></i>Security &amp; DB Health</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <!-- Currency Switcher -->
                        <select id="currencySwitcher" class="form-select form-select-sm sn-pill-select" aria-label="Currency">
                            <option value="MYR" selected="@(currency == "MYR")">MYR (RM)</option>
                            <option value="USD" selected="@(currency == "USD")">USD ($)</option>
                            <option value="SGD" selected="@(currency == "SGD")">SGD (S$)</option>
                        </select>

                        <!-- Theme Toggle -->
                        <button type="button" id="themeToggle" class="btn btn-sm sn-icon-btn" title="Toggle Dark/Light Theme">
                            <i class="bi @(theme == "dark" ? "bi-sun-fill" : "bi-moon-stars")"></i>
                        </button>

                        @if (isAuth)
                        {
                            <!-- Notification Bell -->
                            <a class="btn btn-sm sn-icon-btn position-relative" asp-controller="Stay" asp-action="Notifications" title="Notifications">
                                <i class="bi bi-bell"></i>
                                <span id="notifBadge" class="sn-notif-dot d-none">0</span>
                            </a>

                            <!-- User Account Menu -->
                            <div class="dropdown">
                                <button class="btn sn-user-pill dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                    <span class="sn-avatar-initial">@fullName[0]</span>
                                    <span class="d-none d-md-inline text-truncate" style="max-width:120px">@fullName</span>
                                    <span class="badge sn-role-badge">@role</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end sn-dropdown">
                                    <li class="px-3 py-2 small text-muted border-bottom">
                                        <div class="fw-semibold text-body">@fullName</div>
                                        <div>@User.Identity?.Name</div>
                                    </li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle me-2"></i>Profile &amp; Verification</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Sessions"><i class="bi bi-laptop me-2"></i>Active Sessions</a></li>
                                    <li><a class="dropdown-item" asp-controller="Stay" asp-action="ServiceRequests"><i class="bi bi-life-preserver me-2"></i>Service Requests</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger rounded"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-sm sn-btn-ghost" asp-controller="Account" asp-action="Login">Log In</a>
                            <a class="btn btn-sm sn-btn-primary" asp-controller="Account" asp-action="Register">Sign Up</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Flash Notifications -->
    <div class="container-xl mt-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert sn-alert sn-alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert sn-alert sn-alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert sn-alert sn-alert-info alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i>@TempData["Info"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <main class="sn-main pb-5">
        @RenderBody()
    </main>

    <footer class="sn-footer border-top py-4 mt-auto">
        <div class="container-xl d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 small">
            <div class="d-flex align-items-center gap-2">
                <span class="sn-brand-mark sn-brand-mark-sm"><i class="bi bi-house-heart-fill"></i></span>
                <span class="fw-semibold">StayNest Airbnb Booking System</span>
                <span class="text-muted">· BMIT2023 .NET 10 MVC</span>
            </div>
            <div class="d-flex gap-4 text-muted">
                <a asp-controller="Property" asp-action="Catalog" class="text-reset text-decoration-none">Explore Stays</a>
                <a asp-controller="Home" asp-action="Privacy" class="text-reset text-decoration-none">Privacy &amp; Security</a>
                <span>Photo credits: Unsplash</span>
            </div>
        </div>
    </footer>

    <!-- Core Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
