@model CheckoutViewModel
@inject Helper Helper
@{
    ViewData["Title"] = "Secure Checkout";
    var b = Model.Booking!;
    var cover = b.Property.Photos.OrderByDescending(ph => ph.IsPrimary).FirstOrDefault()?.FileName;
    string policyDetail = b.Property.CancellationPolicy switch
    {
        "Strict" => "50% refund if cancelled 7+ days before check-in; non-refundable within 7 days.",
        "Moderate" => "100% refund 5+ days before check-in; 50% refund 1–4 days prior.",
        _ => "100% full refund if cancelled at least 24 hours before check-in."
    };
}
<div class="container-xl py-4" style="max-width:960px">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <a asp-controller="Booking" asp-action="Details" asp-route-id="@b.Id" class="small text-muted text-decoration-none">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to Reservation @b.BookingReference
            </a>
            <h1 class="h2 fw-bold mt-1 mb-0">Complete Your Payment</h1>
        </div>
        <span class="badge bg-success-subtle text-success px-3 py-2"><i class="bi bi-shield-lock-fill me-1" aria-hidden="true"></i>Encrypted Checkout</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <form asp-action="Process" method="post" class="sn-card p-4" id="checkoutForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BookingId" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <h2 class="h5 fw-bold mb-3">Choose Payment Method</h2>
                <div class="row g-2 mb-2" role="radiogroup" aria-label="Payment method">
                    <div class="col-4">
                        <input type="radio" class="btn-check pay-method" name="PaymentMethod" id="pmCard" value="Credit / Debit Card" checked="@(Model.PaymentMethod == "Credit / Debit Card")" />
                        <label class="btn sn-pay-tab w-100 btn-sm" for="pmCard"><i class="bi bi-credit-card me-1" aria-hidden="true"></i>Card</label>
                    </div>
                    <div class="col-4">
                        <input type="radio" class="btn-check pay-method" name="PaymentMethod" id="pmFpx" value="FPX Online Banking" checked="@(Model.PaymentMethod == "FPX Online Banking")" />
                        <label class="btn sn-pay-tab w-100 btn-sm" for="pmFpx"><i class="bi bi-bank me-1" aria-hidden="true"></i>FPX</label>
                    </div>
                    <div class="col-4">
                        <input type="radio" class="btn-check pay-method" name="PaymentMethod" id="pmTng" value="Touch 'n Go eWallet" checked="@(Model.PaymentMethod == "Touch 'n Go eWallet")" />
                        <label class="btn sn-pay-tab w-100 btn-sm" for="pmTng"><i class="bi bi-phone me-1" aria-hidden="true"></i>TnG eWallet</label>
                    </div>
                </div>
                <span asp-validation-for="PaymentMethod" class="text-danger small d-block mb-3"></span>

                <!-- Credit / Debit Card Section -->
                <div id="secCard">
                    <div class="mb-3">
                        <label asp-for="CardHolderName" class="form-label small fw-semibold"></label>
                        <input asp-for="CardHolderName" class="form-control" autocomplete="cc-name" />
                        <span asp-validation-for="CardHolderName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CardNumber" class="form-label small fw-semibold"></label>
                        <input asp-for="CardNumber" class="form-control font-monospace" placeholder="4242 4242 4242 4242" autocomplete="cc-number" />
                        <span asp-validation-for="CardNumber" class="text-danger small"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label asp-for="CardExpiry" class="form-label small fw-semibold"></label>
                            <input asp-for="CardExpiry" class="form-control font-monospace" placeholder="12/29" autocomplete="cc-exp" />
                            <span asp-validation-for="CardExpiry" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="CardCvv" class="form-label small fw-semibold"></label>
                            <input asp-for="CardCvv" class="form-control font-monospace" placeholder="123" maxlength="4" autocomplete="cc-csc" />
                            <span asp-validation-for="CardCvv" class="text-danger small"></span>
                        </div>
                    </div>
                    <details class="mt-3 small text-muted">
                        <summary style="cursor:pointer">Sandbox test card details</summary>
                        <div class="sn-soft-box p-2 px-3 mt-2">Card: <code>4242 4242 4242 4242</code> · Expiry: <code>12/29</code> · CVV: <code>123</code></div>
                    </details>
                </div>

                <!-- FPX Online Banking Section -->
                <div id="secFpx" class="d-none">
                    <label asp-for="FpxBank" class="form-label small fw-semibold">Select Malaysian FPX Bank</label>
                    <select asp-for="FpxBank" class="form-select">
                        <option value="">-- Choose Bank --</option>
                        <option value="Maybank2u">Maybank2u</option>
                        <option value="CIMB Clicks">CIMB Clicks</option>
                        <option value="Public Bank PBe">Public Bank PBe</option>
                        <option value="RHB Now">RHB Now</option>
                        <option value="Hong Leong Connect">Hong Leong Connect</option>
                    </select>
                    <span asp-validation-for="FpxBank" class="text-danger small"></span>
                </div>

                <!-- TnG eWallet Section -->
                <div id="secTng" class="d-none">
                    <label asp-for="WalletPhone" class="form-label small fw-semibold">Touch 'n Go Registered Mobile Number</label>
                    <input asp-for="WalletPhone" class="form-control" placeholder="012-3456789" />
                    <span asp-validation-for="WalletPhone" class="text-danger small"></span>
                </div>

                <button type="submit" id="paySubmitBtn" class="btn sn-btn-primary w-100 py-2 mt-4 fs-6">
                    <i class="bi bi-lock-fill me-2" aria-hidden="true"></i>Pay @Helper.FormatMoney(b.TotalAmount) &amp; Confirm Stay
                </button>
            </form>
        </div>

        <!-- Order Summary (100% Synced to Active Currency) -->
        <div class="col-lg-5">
            <div class="sn-card p-4">
                <div class="d-flex gap-3 pb-3 mb-3 border-bottom align-items-center">
                    <img src="@Helper.ResolveOptimizedPhotoUrl(cover, "properties", 160, 120)" alt="@b.Property.Title" width="80" height="60" class="rounded object-fit-cover flex-shrink-0" />
                    <div>
                        <h2 class="h6 fw-bold mb-1">@b.Property.Title</h2>
                        <div class="small text-muted">@b.CheckInDate.ToString("dd MMM yyyy") – @b.CheckOutDate.ToString("dd MMM yyyy") · @b.TotalNights @(b.TotalNights == 1 ? "night" : "nights") · @b.GuestCount @(b.GuestCount == 1 ? "guest" : "guests")</div>
                    </div>
                </div>
                <div class="small sn-num">
                    <div class="d-flex justify-content-between mb-1"><span>Stay Subtotal</span><span>@Helper.FormatMoney(b.SubtotalAmount)</span></div>
                    <div class="d-flex justify-content-between mb-1"><span>Cleaning Fee</span><span>@Helper.FormatMoney(b.CleaningFee)</span></div>
                    <div class="d-flex justify-content-between mb-1"><span>Service Tax (10%)</span><span>@Helper.FormatMoney(b.ServiceTax)</span></div>
                    @if (b.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-1 text-success"><span>Promo (@b.PromoCode?.Code)</span><span>-@Helper.FormatMoney(b.DiscountAmount)</span></div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between fs-5 fw-bold"><span>Total Due</span><span>@Helper.FormatMoney(b.TotalAmount)</span></div>
                </div>
                <div class="sn-soft-box p-3 small mt-3 text-muted">
                    <strong class="text-body d-block mb-1">@b.Property.CancellationPolicy Cancellation Policy</strong>
                    @policyDetail
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function syncMethod() {
            const val = document.querySelector('.pay-method:checked')?.value;
            document.getElementById('secCard').classList.toggle('d-none', val !== 'Credit / Debit Card');
            document.getElementById('secFpx').classList.toggle('d-none', val !== 'FPX Online Banking');
            document.getElementById('secTng').classList.toggle('d-none', val !== "Touch 'n Go eWallet");
        }
        document.querySelectorAll('.pay-method').forEach(r => r.addEventListener('change', syncMethod));
        syncMethod();

        document.getElementById('checkoutForm')?.addEventListener('submit', function () {
            const btn = document.getElementById('paySubmitBtn');
            if (btn && (!window.jQuery || jQuery(this).valid())) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Processing Payment...';
            }
        });
    </script>
}
