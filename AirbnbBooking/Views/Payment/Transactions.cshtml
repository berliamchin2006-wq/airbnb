@model List<Payment>
@inject Helper Helper
@{
    ViewData["Title"] = "Platform Transactions & Payout Settlement";
    var payouts = ViewBag.PendingPayouts as List<HostPayout> ?? [];
}
<div class="container-xl py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="sn-eyebrow">Module 4 · Admin Financial Console</span>
            <h2 class="fw-bold mt-1 mb-0">Transactions &amp; Host Payout Settlement</h2>
        </div>
        <a asp-controller="Dashboard" asp-action="ExportAdminReportCsv" class="btn sn-btn-dark btn-sm"><i class="bi bi-download me-1"></i>Export Transactions CSV</a>
    </div>

    <!-- Host Payout Settlement Queue (with Batch Disbursement) -->
    <div class="sn-card p-4 mb-4">
        <form asp-action="BatchDisbursePayouts" method="post">
            @Html.AntiForgeryToken()
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Host Payout Queue</h5>
                <button type="submit" class="btn sn-btn-primary btn-sm">Batch Disburse Selected Pending</button>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="small text-muted">
                        <tr><th></th><th>Ref</th><th>Host</th><th>Property</th><th>Net Payout</th><th>Scheduled</th><th>Status</th><th class="text-end">Action</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var hp in payouts)
                        {
                            <tr>
                                <td>
                                    @if (hp.Status == "Pending")
                                    {
                                        <input type="checkbox" name="payoutIds" value="@hp.Id" class="form-check-input" />
                                    }
                                </td>
                                <td class="font-monospace small">@hp.PayoutReference</td>
                                <td class="small fw-semibold">@hp.Host.FullName</td>
                                <td class="small">@hp.Booking.Property.Title</td>
                                <td class="small fw-bold">@Helper.FormatMoney(hp.NetPayoutAmount)</td>
                                <td class="small">@hp.ScheduledDate.ToString("dd MMM yyyy")</td>
                                <td><span class="sn-status sn-status-@hp.Status">@hp.Status</span></td>
                                <td class="text-end">
                                    @if (hp.Status == "Pending")
                                    {
                                        <button type="submit" formaction="@Url.Action("DisbursePayout", "Payment", new { id = hp.Id })" class="btn btn-sm btn-outline-success">Disburse</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    </div>

    <!-- All Guest Payments & Refunds -->
    <div class="sn-card p-4">
        <h5 class="fw-bold mb-3">Guest Payment &amp; Refund Ledger</h5>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="small text-muted">
                    <tr><th>Txn Ref</th><th>Date</th><th>Booking</th><th>Guest</th><th>Method</th><th>Amount</th><th>Refunded</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="font-monospace small fw-semibold">@p.TransactionRef</td>
                            <td class="small">@p.PaymentDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="small">@p.Booking.BookingReference</td>
                            <td class="small">@p.Booking.Guest.FullName</td>
                            <td class="small">@p.PaymentMethod</td>
                            <td class="small fw-bold">@Helper.FormatMoney(p.Amount)</td>
                            <td class="small text-danger">@(p.RefundAmount > 0 ? Helper.FormatMoney(p.RefundAmount) : "-")</td>
                            <td><span class="sn-status sn-status-@p.Status">@p.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
