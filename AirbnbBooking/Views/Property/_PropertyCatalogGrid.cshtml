@model PropertySearchViewModel
@inject Helper Helper
@using System.Text.Json
@{
    var mapPins = Model.Results.Select(p =>
    {
        var cover = p.Photos.OrderByDescending(ph => ph.IsPrimary).ThenBy(ph => ph.DisplayOrder).FirstOrDefault()?.FileName;
        return new
        {
            id = p.Id,
            title = p.Title,
            city = p.City,
            lat = p.Latitude,
            lng = p.Longitude,
            price = Helper.FormatMoney(p.BaseNightlyRate),
            photo = Helper.ResolvePhotoUrl(cover, "properties")
        };
    }).ToList();
}

<script type="application/json" id="mapPinsJson">@Html.Raw(JsonSerializer.Serialize(mapPins))</script>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="small text-muted">
        Showing <strong class="text-body">@Model.Results.Count</strong> of <strong class="text-body">@Model.TotalCount</strong> available stay(s)
        @if (Model.CheckIn.HasValue && Model.CheckOut.HasValue)
        {
            <span class="ms-2 badge bg-success-subtle text-success">
                <i class="bi bi-calendar-check me-1"></i>Available @Model.CheckIn.Value.ToString("dd MMM") – @Model.CheckOut.Value.ToString("dd MMM")
            </span>
        }
    </div>
</div>

@if (Model.Results.Count == 0)
{
    <div class="sn-card p-5 text-center">
        <i class="bi bi-house-slash display-5 text-muted"></i>
        <h5 class="fw-bold mt-3">No properties match your current filters</h5>
        <p class="text-muted small">Try clearing dates, lowering guest count, or widening your price range.</p>
        <a asp-action="Catalog" class="btn sn-btn-primary btn-sm">Clear All Filters</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var p in Model.Results)
        {
            var cover = p.Photos.OrderByDescending(ph => ph.IsPrimary).ThenBy(ph => ph.DisplayOrder).FirstOrDefault()?.FileName;
            string coverUrl = Helper.ResolvePhotoUrl(cover, "properties");
            bool saved = Model.WishlistedPropertyIds.Contains(p.Id);

            <div class="col-md-6 col-lg-4">
                <article class="sn-prop-card">
                    <div class="sn-prop-media">
                        <a asp-action="Details" asp-route-id="@p.Id">
                            <img src="@coverUrl" alt="@p.Title" loading="lazy" />
                        </a>
                        <span class="sn-prop-tag">@p.PropertyType</span>
                        <button type="button" class="sn-wish-btn @(saved ? "saved" : "")" data-property-id="@p.Id" title="Save to Wishlist">
                            <i class="bi @(saved ? "bi-heart-fill" : "bi-heart")"></i>
                        </button>
                    </div>
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                            <div class="small text-muted fw-medium">@p.City, @p.State</div>
                            <div class="small fw-semibold flex-shrink-0">
                                <i class="bi bi-star-fill text-warning me-1"></i>@(p.ReviewCount > 0 ? $"{p.AverageRating:0.0} ({p.ReviewCount})" : "New")
                            </div>
                        </div>
                        <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-reset">
                            <h6 class="fw-bold mb-2">@p.Title</h6>
                        </a>
                        <div class="small text-muted mb-3">
                            <span>@p.MaxGuests guests</span> · <span>@p.Bedrooms bd</span> · <span>@p.Bathrooms ba</span>
                            @if (p.SeasonalRates.Any())
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis ms-1">Seasonal Pricing</span>
                            }
                        </div>
                        <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold fs-6">@Helper.FormatMoney(p.BaseNightlyRate)</span>
                                <span class="small text-muted">/ night</span>
                            </div>
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm sn-btn-ghost">Explore →</a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-center">
            <ul class="pagination pagination-sm">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link ajax-page-link" href="#" data-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
