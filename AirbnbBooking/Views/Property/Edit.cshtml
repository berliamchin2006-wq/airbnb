@model PropertyFormViewModel
@{
    ViewData["Title"] = "Edit Listing & Seasonal Rates";
}
<div class="container-xl py-4" style="max-width:1040px">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <span class="sn-eyebrow">Module 2 · Manage Listing #@Model.Id</span>
            <h2 class="fw-bold mt-1 mb-0">@Model.Title</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn sn-btn-ghost btn-sm">Preview Public Page</a>
            <a asp-action="MyProperties" class="btn sn-btn-ghost btn-sm">My Listings</a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Listing Form -->
        <div class="col-lg-8">
            <form asp-action="Edit" method="post" enctype="multipart/form-data" class="sn-card p-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label small fw-semibold"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PropertyType" class="form-label small fw-semibold"></label>
                        <select asp-for="PropertyType" class="form-select">
                            @foreach (var t in new[] { "Condominium", "Villa", "Townhouse", "Chalet", "Studio", "Apartment", "Bungalow" })
                            {
                                <option value="@t" selected="@(Model.PropertyType == t)">@t</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label small fw-semibold"></label>
                        <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label small fw-semibold"></label>
                        <input asp-for="Address" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="City" class="form-label small fw-semibold"></label>
                        <input asp-for="City" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="State" class="form-label small fw-semibold"></label>
                        <input asp-for="State" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Postcode" class="form-label small fw-semibold"></label>
                        <input asp-for="Postcode" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Latitude" class="form-label small fw-semibold"></label>
                        <input asp-for="Latitude" id="editLat" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Longitude" class="form-label small fw-semibold"></label>
                        <input asp-for="Longitude" id="editLng" class="form-control form-control-sm" />
                    </div>
                    <div class="col-12">
                        <div id="editMap" style="height:220px;border-radius:12px;"></div>
                    </div>
                    <div class="col-3">
                        <label asp-for="MaxGuests" class="form-label small fw-semibold"></label>
                        <input asp-for="MaxGuests" class="form-control" />
                    </div>
                    <div class="col-3">
                        <label asp-for="Bedrooms" class="form-label small fw-semibold"></label>
                        <input asp-for="Bedrooms" class="form-control" />
                    </div>
                    <div class="col-3">
                        <label asp-for="Beds" class="form-label small fw-semibold"></label>
                        <input asp-for="Beds" class="form-control" />
                    </div>
                    <div class="col-3">
                        <label asp-for="Bathrooms" class="form-label small fw-semibold"></label>
                        <input asp-for="Bathrooms" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="BaseNightlyRate" class="form-label small fw-semibold"></label>
                        <input asp-for="BaseNightlyRate" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="CustomWeekendRate" class="form-label small fw-semibold"></label>
                        <input asp-for="CustomWeekendRate" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="CleaningFee" class="form-label small fw-semibold"></label>
                        <input asp-for="CleaningFee" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="CancellationPolicy" class="form-label small fw-semibold"></label>
                        <select asp-for="CancellationPolicy" class="form-select">
                            <option value="Flexible">Flexible</option>
                            <option value="Moderate">Moderate</option>
                            <option value="Strict">Strict</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="HouseRules" class="form-label small fw-semibold"></label>
                        <textarea asp-for="HouseRules" rows="2" class="form-control"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Amenities</label>
                        <div class="row g-2">
                            @foreach (var am in Model.AllAmenities)
                            {
                                bool chk = Model.SelectedAmenityIds.Contains(am.Id);
                                <div class="col-6 col-md-4">
                                    <label class="sn-soft-box p-2 px-3 d-flex align-items-center gap-2 small mb-0">
                                        <input type="checkbox" class="form-check-input mt-0" name="SelectedAmenityIds" value="@am.Id" checked="@chk" />
                                        <i class="bi @am.IconClass text-danger"></i>
                                        <span>@am.Name</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Add More Gallery Photos</label>
                        <input asp-for="Photos" type="file" multiple accept="image/*" class="form-control form-control-sm" />
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label small fw-semibold">Listing is Published &amp; Bookable</label>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn sn-btn-primary mt-4 px-4">Save Changes</button>
            </form>
        </div>

        <!-- Side Column: Gallery Manager & Seasonal Rates Manager -->
        <div class="col-lg-4">
            <!-- Photo Gallery Manager -->
            <div class="sn-card p-4 mb-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-images text-danger me-2"></i>Gallery (@Model.ExistingPhotos.Count photos)</h6>
                <div class="d-flex flex-column gap-2">
                    @foreach (var ph in Model.ExistingPhotos)
                    {
                        <div class="sn-soft-box p-2 d-flex align-items-center gap-2">
                            <img src="@Helper.ResolvePhotoUrl(ph.FileName, "properties")" class="rounded" style="width:68px;height:50px;object-fit:cover" />
                            <div class="flex-grow-1 small">
                                @if (ph.IsPrimary)
                                {
                                    <span class="badge bg-danger">Primary Cover</span>
                                }
                                else
                                {
                                    <form asp-action="SetPrimaryPhoto" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="propertyId" value="@Model.Id" />
                                        <input type="hidden" name="photoId" value="@ph.Id" />
                                        <button type="submit" class="btn btn-link btn-sm p-0 text-decoration-none">Set Primary</button>
                                    </form>
                                }
                            </div>
                            @if (Model.ExistingPhotos.Count > 1)
                            {
                                <form asp-action="DeletePhoto" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="propertyId" value="@Model.Id" />
                                    <input type="hidden" name="photoId" value="@ph.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Custom Seasonal Rate Manager -->
            <div class="sn-card p-4">
                <h6 class="fw-bold mb-2"><i class="bi bi-calendar-range text-danger me-2"></i>Custom Seasonal Rates</h6>
                <p class="small text-muted mb-3">Override base rates during holidays or peak travel periods.</p>

                @foreach (var sr in Model.ExistingSeasonalRates)
                {
                    <div class="sn-soft-box p-2 px-3 mb-2 d-flex justify-content-between align-items-center small">
                        <div>
                            <div class="fw-semibold">@sr.SeasonName</div>
                            <div class="text-muted">@sr.StartDate.ToString("dd MMM") – @sr.EndDate.ToString("dd MMM yyyy") · <strong>RM @sr.NightlyRate.ToString("N2")</strong></div>
                        </div>
                        <form asp-action="DeleteSeasonalRate" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@sr.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2"><i class="bi bi-x-lg"></i></button>
                        </form>
                    </div>
                }

                <form asp-action="AddSeasonalRate" method="post" class="border-top pt-3 mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PropertyId" value="@Model.Id" />
                    <div class="mb-2">
                        <input name="SeasonName" class="form-control form-control-sm" placeholder="Season name (e.g. CNY Peak)" required />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="small text-muted">Start</label>
                            <input name="StartDate" type="date" class="form-control form-control-sm" value="@DateTime.Today.AddDays(20).ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6">
                            <label class="small text-muted">End</label>
                            <input name="EndDate" type="date" class="form-control form-control-sm" value="@DateTime.Today.AddDays(28).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                    <div class="mb-2">
                        <input name="NightlyRate" type="number" step="0.01" min="20" class="form-control form-control-sm" placeholder="Nightly Rate (RM)" required />
                    </div>
                    <button type="submit" class="btn sn-btn-dark btn-sm w-100">Add Seasonal Rate</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const eMap = L.map('editMap').setView([@Model.Latitude, @Model.Longitude], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OSM' }).addTo(eMap);
        const epin = L.marker([@Model.Latitude, @Model.Longitude], { draggable: true }).addTo(eMap);
        epin.on('dragend', e => {
            const p = e.target.getLatLng();
            document.getElementById('editLat').value = p.lat.toFixed(6);
            document.getElementById('editLng').value = p.lng.toFixed(6);
        });
        eMap.on('click', e => {
            epin.setLatLng(e.latlng);
            document.getElementById('editLat').value = e.latlng.lat.toFixed(6);
            document.getElementById('editLng').value = e.latlng.lng.toFixed(6);
        });
    </script>
}
