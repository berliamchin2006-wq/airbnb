@model PropertyDetailViewModel
@inject Helper Helper
@{
    var p = Model.Property;















    ViewData["Title"] = p.Title;















    var photos = p.Photos.OrderByDescending(ph => ph.IsPrimary).ThenBy(ph => ph.DisplayOrder).ToList();















    string mainImg = Helper.ResolveOptimizedPhotoUrl(photos.FirstOrDefault()?.FileName, "properties", 960, 640);
    bool hasMultiplePhotos = photos.Count > 1;
    string policySummary = p.CancellationPolicy switch
    {
        "Strict" => "50% refund up to 7 days before check-in.",
        "Moderate" => "Full refund 5+ days prior; 50% refund 1–4 days prior.",
        _ => "Full refund up to 24 hours before check-in."
    };
    string activeCurrency = Helper.GetActiveCurrency();
}
<div class="container-xl py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 small text-muted">
                <span class="fw-semibold text-body">@p.PropertyType</span>
                <span>·</span>
                <span>@p.CancellationPolicy Cancellation</span>
            </div>
            <h1 class="h3 fw-bold mb-1">@p.Title</h1>
            <div class="small text-muted d-flex flex-wrap gap-3">
                <span class="sn-num"><i class="bi bi-star-fill text-warning me-1" aria-hidden="true"></i><strong>@(p.ReviewCount > 0 ? p.AverageRating.ToString("0.00") : "New")</strong> (@p.ReviewCount @(p.ReviewCount == 1 ? "review" : "reviews"))</span>
                <span><i class="bi bi-geo-alt-fill sn-link-accent me-1" aria-hidden="true"></i>@p.Address, @p.City, @p.State</span>
                <span>
                    Hosted by <strong>@p.Host.FullName</strong>
                    @if (p.Host.IdentityStatus == "Verified")
                    {
                        <span class="ms-1 text-success"><i class="bi bi-patch-check-fill" aria-hidden="true"></i> Verified</span>
                    }
                </span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn sn-btn-ghost btn-sm sn-wish-btn position-static rounded-pill px-3 @(Model.IsWishlisted ? "saved" : "")" style="width:auto;height:auto;box-shadow:none" data-property-id="@p.Id" aria-label="@(Model.IsWishlisted ? "Remove from saved stays" : "Save this stay")" aria-pressed="@(Model.IsWishlisted ? "true" : "false")">
                <i class="bi @(Model.IsWishlisted ? "bi-heart-fill" : "bi-heart") me-1" aria-hidden="true"></i>Save
            </button>
            @if (Helper.IsOwnerOrAdmin(p.HostId))
            {
                <a asp-action="Edit" asp-route-id="@p.Id" class="btn sn-btn-dark btn-sm"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit Listing</a>
            }
        </div>
    </div>

    <!-- Multi-Photo Gallery (No duplicate single-photo repetition, fixed height grid) -->
    <div class="sn-gallery @(hasMultiplePhotos ? "" : "sn-gallery-single") mb-4">
        <img src="@mainImg" alt="@p.Title main view" width="960" height="640" fetchpriority="high" decoding="async" class="sn-gallery-main" />
        @if (hasMultiplePhotos)
        {
            <div class="sn-gallery-side">
                @for (int i = 1; i < Math.Min(3, photos.Count); i++)
                {
                    <img src="@Helper.ResolveOptimizedPhotoUrl(photos[i].FileName, "properties", 520, 340)" alt="@p.Title gallery photo @(i + 1)" width="520" height="340" decoding="async" />
                }
            </div>
        }
    </div>

    <div class="row g-4">
        <!-- Left Content Column -->
        <div class="col-lg-8">
            <div class="sn-card p-4 mb-4">
                <div class="d-flex flex-wrap gap-4 pb-3 mb-3 border-bottom small fw-semibold">
                    <span><i class="bi bi-people me-1 sn-link-accent" aria-hidden="true"></i>Up to @p.MaxGuests @(p.MaxGuests == 1 ? "guest" : "guests")</span>
                    <span><i class="bi bi-door-closed me-1 sn-link-accent" aria-hidden="true"></i>@p.Bedrooms @(p.Bedrooms == 1 ? "bedroom" : "bedrooms")</span>
                    <span><i class="bi bi-moon me-1 sn-link-accent" aria-hidden="true"></i>@p.Beds @(p.Beds == 1 ? "bed" : "beds")</span>
                    <span><i class="bi bi-droplet me-1 sn-link-accent" aria-hidden="true"></i>@p.Bathrooms @(p.Bathrooms == 1 ? "bathroom" : "bathrooms")</span>
                </div>
                <h2 class="h5 fw-bold mb-2">About this space</h2>
                <p class="text-muted mb-4" style="white-space:pre-line">@p.Description</p>

                <h2 class="h5 fw-bold mb-3">Amenities included</h2>
                <div class="row g-2 mb-4">
                    @foreach (var pa in p.PropertyAmenities)















                    {
                        <div class="col-6 col-md-4">
                            <div class="sn-soft-box px-3 py-2 small d-flex align-items-center gap-2">
                                <i class="bi @pa.Amenity.IconClass sn-link-accent" aria-hidden="true"></i>
                                <span>@pa.Amenity.Name</span>
                            </div>
                        </div>
                    }
                </div>

                @if (p.SeasonalRates.Any())















                {
                    <h2 class="h5 fw-bold mb-2">Seasonal &amp; Holiday Rates</h2>
                    <div class="table-responsive mb-4">
                        <table class="table table-sm small mb-0">
                            <thead>
                                <tr>
                                    <th>Season</th>
                                    <th>Dates</th>
                                    <th>Nightly Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sr in p.SeasonalRates)















                                {
                                    <tr>
                                        <td class="fw-semibold">@sr.SeasonName</td>
                                        <td>@sr.StartDate.ToString("dd MMM yyyy") – @sr.EndDate.ToString("dd MMM yyyy")</td>
                                        <td class="fw-bold sn-link-accent">@Helper.FormatMoney(sr.NightlyRate)/night</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="sn-soft-box p-3 small">
                    <strong><i class="bi bi-clipboard-check sn-link-accent me-1" aria-hidden="true"></i>House Rules:</strong>
                    <span class="text-muted ms-1">@p.HouseRules</span>
                    <div class="text-muted mt-1">
                        <strong>@p.CancellationPolicy Cancellation:</strong> @policySummary
                    </div>
                </div>
            </div>

            <!-- Interactive Location Map (Lazy-loaded via IntersectionObserver) -->
            <div class="sn-card p-4 mb-4">
                <h2 class="h5 fw-bold mb-2"><i class="bi bi-geo-alt sn-link-accent me-1" aria-hidden="true"></i>Location &amp; Neighborhood</h2>
                <p class="small text-muted mb-3">@p.Address, @p.Postcode @p.City, @p.State</p>
                <div id="detailMap" style="height:280px;border-radius:12px;background:var(--sn-surface-soft)" aria-label="Interactive map showing property location in @p.City"></div>
            </div>

            <!-- Reviews & 4-Category Reputation Breakdown -->
            <div class="sn-card p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h2 class="h5 fw-bold mb-0 sn-num"><i class="bi bi-star-fill text-warning me-2" aria-hidden="true"></i>@(p.ReviewCount > 0 ? $"{p.AverageRating:0.00} · {p.ReviewCount} Verified {(p.ReviewCount == 1 ? "Review" : "Reviews")}" : "Guest Reviews")</h2>
                    <span class="small text-muted">Fair mutual reviews published after both parties submit or 14 days</span>
                </div>

                @if (Model.PublishedReviews.Count > 0)















                {
                    <div class="row g-3 mb-4">
                        @foreach (var metric in new[] { ("Cleanliness", Model.AvgCleanliness), ("Accuracy",
                    Model.AvgAccuracy), ("Communication", Model.AvgCommunication), ("Location", Model.AvgLocation) })















                        {
                            <div class="col-6 col-md-3">
                                <div class="sn-soft-box p-2 text-center sn-num">
                                    <div class="small text-muted">@metric.Item1</div>
                                    <div class="fw-bold fs-5">@metric.Item2.ToString("0.0")</div>
                                </div>
                            </div>
                        }
                    </div>

                    @foreach (var rev in Model.PublishedReviews)

                    {
                        <div class="border-top pt-3 mt-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>@rev.Guest.FullName</strong>
                                    <span class="small text-muted ms-2">@rev.CreatedAt.ToString("dd MMM yyyy")</span>
                                </div>
                                <span class="badge bg-warning-subtle text-warning-emphasis sn-num"><i class="bi bi-star-fill me-1" aria-hidden="true"></i>@rev.OverallRating.ToString("0.0")</span>
                            </div>
                            <p class="small mt-2 mb-2">@rev.Comment</p>
                            @if (!string.IsNullOrEmpty(rev.PhotoPath))

                            {
                                <img src="@Helper.ResolvePhotoUrl(rev.PhotoPath, "reviews")" alt="Photo submitted by @rev.Guest.FullName" loading="lazy" decoding="async" class="rounded mb-2" style="max-height:130px" />
                            }
                            @if (!string.IsNullOrEmpty(rev.HostReply))

                            {
                                <div class="sn-soft-box p-2 px-3 small mb-2">
                                    <strong>Host reply:</strong> @rev.HostReply
                                </div>
                            }
                            <div class="d-flex align-items-center gap-3 small">
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted helpful-btn" data-id="@rev.Id">
                                    <i class="bi bi-hand-thumbs-up me-1" aria-hidden="true"></i>Helpful (<span class="vote-count sn-num">@rev.HelpfulVotes</span>)
                                </button>
                                @if (User.Identity?.IsAuthenticated == true)















                                {
                                    <form asp-controller="Review" asp-action="FlagReview" method="post" class="d-inline" onsubmit="return confirm('Report this review to StayNest moderators?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@rev.Id" />
                                        <input type="hidden" name="reason" value="Reported by user from listing page" />
                                        <button type="submit"
                                            class="btn btn-link btn-sm p-0 text-decoration-none text-muted">Report</button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                }















                else















                {
                    <p class="small text-muted mb-0">No published reviews yet. Reviews appear automatically once both guest and host submit or after the 14-day review window.</p>
                }
            </div>
        </div>

        <!-- Sticky Booking & Live Price Calculator Widget -->
        <div class="col-lg-4">
            <div class="sn-card p-4 sticky-top" style="top:86px;z-index:20">
                <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-1 mb-3 sn-num">
                    <div class="text-nowrap">
                        <span class="fs-4 fw-bold">@Helper.FormatMoney(p.BaseNightlyRate)</span>
                        <span class="small text-muted">/ night</span>
                    </div>
                    <span class="small text-muted text-nowrap">Weekend: @Helper.FormatMoney(p.CustomWeekendRate)</span>
                </div>

                <!-- Interactive Visual Availability Calendar -->
                <div class="sn-soft-box p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <button type="button" id="calPrev" class="btn sn-btn-ghost cal-nav-btn" aria-label="Previous month"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
                        <strong class="small" id="calMonthLabel"></strong>
                        <button type="button" id="calNext" class="btn sn-btn-ghost cal-nav-btn" aria-label="Next month"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                    </div>
                    <div class="d-grid text-center small text-muted mb-1" style="grid-template-columns:repeat(7,1fr);font-size:.72rem" aria-hidden="true">
                        <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
                    </div>
                    <div id="calGrid" class="d-grid gap-1 text-center" style="grid-template-columns:repeat(7,1fr)">
                    </div>
                    <div class="d-flex justify-content-between mt-2 pt-2 border-top" style="font-size:.72rem">
                        <span class="text-muted"><span class="d-inline-block rounded-circle me-1" style="width:7px;height:7px;background:var(--sn-accent)"></span>Selected</span>
                        <span class="text-muted"><span class="d-inline-block rounded-circle bg-secondary opacity-50 me-1" style="width:7px;height:7px"></span>Unavailable</span>
                    </div>
                </div>

                <!-- Booked Dates Indicator -->
                <div id="bookedDatesBox" class="sn-soft-box p-2 px-3 small mb-3 d-none">
                    <div class="fw-semibold mb-1"><i class="bi bi-calendar-x sn-link-accent me-1" aria-hidden="true"></i>Already Booked:</div>
                    <div id="bookedDatesList" class="text-muted"></div>
                </div>

                <form asp-controller="Booking" asp-action="Create" method="post" id="bookingForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PropertyId" value="@p.Id" />

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label for="bkCheckIn" class="form-label small fw-semibold mb-1">Check-In</label>
                            <input type="date" id="bkCheckIn" name="CheckInDate"
                                value="@Model.BookingForm.CheckInDate.ToString("yyyy-MM-dd")"
                                min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-sm"
                                required />
                        </div>
                        <div class="col-6">
                            <label for="bkCheckOut" class="form-label small fw-semibold mb-1">Check-Out</label>
                            <input type="date" id="bkCheckOut" name="CheckOutDate"
                                value="@Model.BookingForm.CheckOutDate.ToString("yyyy-MM-dd")"
                                min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                                class="form-control form-control-sm" required />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label for="bkGuests" class="form-label small fw-semibold mb-1">Guests (max @p.MaxGuests)</label>
                        <input type="number" id="bkGuests" name="GuestCount" value="@Model.BookingForm.GuestCount" min="1" max="@p.MaxGuests" class="form-control form-control-sm" required />
                    </div>

                    <div class="mb-2">
                        <label for="bkPromo" class="form-label small fw-semibold mb-1">Promo Code</label>
                        <div class="input-group input-group-sm">
                            <input type="text" id="bkPromo" name="PromoCode" class="form-control text-uppercase" placeholder="Optional voucher code" />
                            <button type="button" id="applyPromoBtn" class="btn sn-btn-ghost">Apply</button>
                        </div>
                        <div id="promoFeedback" class="small mt-1" aria-live="polite"></div>
                    </div>

                    <details class="mb-3">
                        <summary class="small fw-semibold text-muted" style="cursor:pointer">Add special request (optional)</summary>
                        <div class="mt-2">
                            <label for="bkRequests" class="visually-hidden">Special Requests</label>
                            <textarea id="bkRequests" name="SpecialRequests" rows="2" class="form-control form-control-sm" placeholder="Arrival time, extra pillows..."></textarea>
                        </div>
                    </details>

                    <!-- Live AJAX Price Breakdown (Synced to Active Currency) -->
                    <div id="priceError" class="alert sn-alert sn-alert-danger small py-2 d-none" role="alert" aria-live="assertive"></div>
                    <div id="priceBreakdown" class="sn-soft-box p-3 small mb-3" aria-live="polite">
                        <div class="d-flex justify-content-between mb-1"><span>Stay subtotal (<span id="pbNights">3</span> nights)</span><strong id="pbSub">—</strong></div>
                        <div class="d-flex justify-content-between mb-1"><span>Cleaning fee</span><span id="pbClean">—</span></div>
                        <div class="d-flex justify-content-between mb-1"><span>Service tax (10%)</span><span id="pbTax">—</span></div>
                        <div id="pbDiscRow" class="d-flex justify-content-between mb-1 text-success d-none"><span>Promo discount</span><span id="pbDisc">—</span></div>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between fs-6 fw-bold"><span>Total (@activeCurrency)</span><span id="pbTotal">—</span></div>
                    </div>

                    @if (User.Identity?.IsAuthenticated == true)















                    {
                        <button type="submit" id="reserveBtn" class="btn sn-btn-primary w-100 py-2">Reserve &amp; Continue to Payment</button>
                    }















                    else















                    {
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@($"/Property/Details/{p.Id}?checkIn={Model.BookingForm.CheckInDate:yyyy-MM-dd}&checkOut={Model.BookingForm.CheckOutDate:yyyy-MM-dd}&guests={Model.BookingForm.GuestCount}")" class="btn sn-btn-primary w-100 py-2">Sign In to Reserve</a>
                    }
                </form>

                <div class="text-center small text-muted mt-3">
                    <i class="bi bi-shield-check me-1 text-success" aria-hidden="true"></i>Instant availability lock · @p.CancellationPolicy cancellation
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Lazy-load Leaflet & init property map only when scrolled near viewport
        let mapLoaded = false;
        const mapEl = document.getElementById('detailMap');
        function initDetailMap() {
            if (mapLoaded || !mapEl) return;
            mapLoaded = true;
            const link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
            document.head.appendChild(link);

            const script = document.createElement('script');
            script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
            script.onload = () => {
                const detailMap = L.map('detailMap').setView([@p.Latitude, @p.Longitude], 14);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(detailMap);
                L.marker([@p.Latitude, @p.Longitude]).addTo(detailMap)
                    .bindPopup("<strong>@p.Title.Replace("\"", "")</strong><br/>@p.City").openPopup();
            };
            document.body.appendChild(script);
        }

        if ('IntersectionObserver' in window && mapEl) {
            const obs = new IntersectionObserver(entries => {
                if (entries.some(e => e.isIntersecting)) {
                    obs.disconnect();
                    initDetailMap();
                }
            }, { rootMargin: '200px' });
            obs.observe(mapEl);
        } else {
            initDetailMap();
        }

        // 2. Booked Dates & Interactive Visual Availability Calendar
        let bookedRanges = [];
        let calCursor = new Date(document.getElementById('bkCheckIn').value + 'T00:00:00');
        if (isNaN(calCursor.getTime())) calCursor = new Date();
        calCursor.setDate(1);
        let pickingCheckout = false;

        function fmtYmd(d) {
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${y}-${m}-${day}`;
        }

        function isBookedDay(ymd) {
            return bookedRanges.some(r => ymd >= r.start && ymd < r.end);
        }

        function renderAvailCalendar() {
            const grid = document.getElementById('calGrid');
            const label = document.getElementById('calMonthLabel');
            if (!grid || !label) return;

            const year = calCursor.getFullYear();
            const month = calCursor.getMonth();
            const monthTitle = calCursor.toLocaleString('en-US', { month: 'long', year: 'numeric' });
            label.textContent = monthTitle;

            const firstDow = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const todayYmd = fmtYmd(new Date());
            const ciYmd = document.getElementById('bkCheckIn').value;
            const coYmd = document.getElementById('bkCheckOut').value;

            let html = '';
            for (let i = 0; i < firstDow; i++) html += '<span></span>';

            for (let day = 1; day <= daysInMonth; day++) {
                const ymd = fmtYmd(new Date(year, month, day));
                const past = ymd < todayYmd;
                const booked = isBookedDay(ymd);
                const isEdge = ymd === ciYmd || ymd === coYmd;
                const inRange = ciYmd && coYmd && ymd > ciYmd && ymd < coYmd;

                let style = '';
                let stateText = 'available';
                if (past || booked) {
                    style = 'background:transparent;color:var(--sn-muted);text-decoration:line-through;opacity:.45;cursor:not-allowed;';
                    stateText = booked ? 'booked' : 'past';
                } else if (isEdge) {
                    style = 'background:var(--sn-accent);color:#fff;font-weight:700;cursor:pointer;';
                    stateText = ymd === ciYmd ? 'selected check-in' : 'selected check-out';
                } else if (inRange) {
                    style = 'background:var(--sn-accent-soft);color:var(--sn-accent);font-weight:600;cursor:pointer;';
                    stateText = 'in selected stay range';
                } else {
                    style = 'background:var(--sn-surface);color:var(--sn-ink);cursor:pointer;';
                }

                html += `<button type="button" class="cal-day" data-ymd="${ymd}" aria-label="${day} ${monthTitle}, ${stateText}" ${(past || booked) ? 'disabled' : ''} style="${style}">${day}</button>`;
            }
            grid.innerHTML = html;
        }

        document.getElementById('calPrev')?.addEventListener('click', () => { calCursor.setMonth(calCursor.getMonth() - 1); renderAvailCalendar(); });
        document.getElementById('calNext')?.addEventListener('click', () => { calCursor.setMonth(calCursor.getMonth() + 1); renderAvailCalendar(); });
        document.getElementById('calGrid')?.addEventListener('click', e => {
            const btn = e.target.closest('.cal-day');
            if (!btn || btn.disabled) return;
            const ymd = btn.dataset.ymd;
            const ciEl = document.getElementById('bkCheckIn');
            const coEl = document.getElementById('bkCheckOut');

            if (!pickingCheckout || ymd <= ciEl.value) {
                ciEl.value = ymd;
                const nextDay = new Date(ymd + 'T00:00:00');
                nextDay.setDate(nextDay.getDate() + 1);
                coEl.value = fmtYmd(nextDay);
                pickingCheckout = true;
            } else {
                coEl.value = ymd;
                pickingCheckout = false;
            }
            renderAvailCalendar();
            refreshPrice();
        });

        fetch('/Booking/GetBookedDates?propertyId=@p.Id')
            .then(r => r.ok ? r.json() : [])
            .then(ranges => {
                bookedRanges = ranges || [];
                if (bookedRanges.length > 0) {
                    document.getElementById('bookedDatesBox').classList.remove('d-none');
                    document.getElementById('bookedDatesList').innerHTML = bookedRanges
                        .map(r => `<span class="badge bg-danger-subtle text-danger me-1 mb-1">${r.start} to ${r.end}</span>`)
                        .join('');
                }
            })
            .catch(() => {})
            .finally(() => renderAvailCalendar());

        // 3. Live AJAX Price Breakdown (Active Currency + Always Clears Stale Promo Discount)
        async function refreshPrice() {
            const ci = document.getElementById('bkCheckIn').value;
            const co = document.getElementById('bkCheckOut').value;
            const promo = document.getElementById('bkPromo').value.trim();
            if (!ci || !co) return;

            const pbBox = document.getElementById('priceBreakdown');
            const errBox = document.getElementById('priceError');
            const reserveBtn = document.getElementById('reserveBtn');
            const promoFb = document.getElementById('promoFeedback');
            pbBox.style.opacity = '0.6';

            try {
                const url = `/Booking/CalculatePrice?propertyId=@p.Id&checkIn=${ci}&checkOut=${co}&promoCode=${encodeURIComponent(promo)}`;
                const res = await fetch(url);
                const data = await res.json();

                if (!data.ok) {
                    errBox.textContent = data.error;
                    errBox.classList.remove('d-none');
                    if (reserveBtn) reserveBtn.disabled = true;
                    return;
                }

                errBox.classList.add('d-none');
                if (reserveBtn) reserveBtn.disabled = false;

                document.getElementById('pbNights').textContent = data.nights;
                document.getElementById('pbSub').textContent = data.subtotalFormatted;
                document.getElementById('pbClean').textContent = data.cleaningFeeFormatted;
                document.getElementById('pbTax').textContent = data.serviceTaxFormatted;
                document.getElementById('pbTotal').textContent = data.totalFormatted;

                const discRow = document.getElementById('pbDiscRow');
                if (data.discount > 0) {
                    discRow.classList.remove('d-none');
                    document.getElementById('pbDisc').textContent = `-${data.discountFormatted}`;
                } else {
                    discRow.classList.add('d-none');
                }

                if (data.promoInvalid) {
                    promoFb.innerHTML = `<span class="text-danger">${data.promoMessage}</span>`;
                } else if (data.promoMessage) {
                    promoFb.innerHTML = `<span class="${data.discount > 0 ? 'text-success' : 'text-warning'}">${data.promoMessage}</span>`;
                } else {
                    promoFb.textContent = '';
                }
            } catch {
                errBox.textContent = 'Could not verify availability right now. Please try again.';
                errBox.classList.remove('d-none');
            } finally {
                pbBox.style.opacity = '1';
            }
        }

        document.getElementById('bkCheckIn')?.addEventListener('change', () => { renderAvailCalendar(); refreshPrice(); });
        document.getElementById('bkCheckOut')?.addEventListener('change', () => { renderAvailCalendar(); refreshPrice(); });
        document.getElementById('applyPromoBtn')?.addEventListener('click', refreshPrice);
        refreshPrice();

        // 4. AJAX Helpful Review Vote
        document.querySelectorAll('.helpful-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const res = await fetch(`/Review/HelpfulVote?id=${btn.dataset.id}`, { method: 'POST' });
                if (res.ok) {
                    const data = await res.json();
                    btn.querySelector('.vote-count').textContent = data.votes;
                }
            });
        });
    </script>
}
