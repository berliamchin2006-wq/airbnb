@model List<AuditLog>
@{
    ViewData["Title"] = "Audit Log Explorer";
}
<div class="container-xl py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <span class="sn-eyebrow">Module 8 · Compliance &amp; Audit Trail</span>
            <h2 class="fw-bold mt-1 mb-0">Security &amp; Financial Audit Explorer</h2>
        </div>
        <a asp-action="ExportAuditCsv" class="btn sn-btn-dark btn-sm"><i class="bi bi-download me-1"></i>Export Audit CSV</a>
    </div>

    <div class="sn-card p-4">
        <form id="auditFilterForm" class="row g-2 mb-3">
            <div class="col-md-5">
                <input type="text" id="auditSearch" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search email, action, IP, or details..." />
            </div>
            <div class="col-md-3">
                <select name="module" class="form-select form-select-sm audit-trigger">
                    <option value="">All Modules</option>
                    @foreach (var m in new[] { "UserIdentity", "Property", "Booking", "Payment", "InStay", "Review", "Security" })
                    {
                        <option value="@m" selected="@((string?)ViewBag.Module == m)">@m</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="severity" class="form-select form-select-sm audit-trigger">
                    <option value="">All Severities</option>
                    <option value="Info">Info</option>
                    <option value="Warning">Warning</option>
                    <option value="Critical">Critical</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn sn-btn-primary btn-sm w-100">Filter</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="small text-muted">
                    <tr><th>Timestamp</th><th>Severity</th><th>Module</th><th>Actor</th><th>Action</th><th>IP</th><th>Details</th></tr>
                </thead>
                <tbody id="auditTableBody">
                    <partial name="_AuditLogRows" model="Model" />
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function loadAudit() {
            const params = new URLSearchParams(new FormData(document.getElementById('auditFilterForm')));
            const res = await fetch('/Security/AuditLogsAjax?' + params.toString());
            if (res.ok) document.getElementById('auditTableBody').innerHTML = await res.text();
        }
        document.getElementById('auditFilterForm')?.addEventListener('submit', e => { e.preventDefault(); loadAudit(); });
        document.querySelectorAll('.audit-trigger').forEach(el => el.addEventListener('change', loadAudit));
        let t;
        document.getElementById('auditSearch')?.addEventListener('input', () => { clearTimeout(t); t = setTimeout(loadAudit, 250); });
    </script>
}
