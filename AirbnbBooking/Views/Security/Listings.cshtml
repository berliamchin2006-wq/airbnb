@model List<Property>
@inject Helper Helper
@{
    ViewData["Title"] = "Admin Listing Moderation";
}
<div class="container-xl py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <span class="sn-eyebrow">Module 8 · Listing Governance</span>
            <h2 class="fw-bold mt-1 mb-0">Property Listing Moderation</h2>
        </div>
        <form method="get" class="d-flex gap-2">
            <input name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Title, city, or host..." />
            <select name="status" class="form-select form-select-sm" style="width:auto">
                <option value="">All</option>
                <option value="active" selected="@((string?)ViewBag.Status == "active")">Published</option>
                <option value="hidden" selected="@((string?)ViewBag.Status == "hidden")">Suspended/Hidden</option>
            </select>
            <button type="submit" class="btn sn-btn-dark btn-sm">Filter</button>
        </form>
    </div>

    <form asp-action="BatchListingAction" method="post" class="sn-card p-4">
        @Html.AntiForgeryToken()
        <div class="d-flex flex-wrap align-items-center gap-2 pb-3 mb-3 border-bottom">
            <span class="small fw-semibold text-muted">Batch Listing Moderation:</span>
            <select name="actionType" class="form-select form-select-sm" style="width:auto">
                <option value="approve">Approve &amp; Publish Selected</option>
                <option value="suspend">Suspend / Hide Selected</option>
            </select>
            <button type="submit" class="btn sn-btn-primary btn-sm">Apply Batch Action</button>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="small text-muted">
                    <tr><th></th><th>Listing</th><th>Host</th><th>Location</th><th>Base Rate</th><th>Bookings</th><th>Rating</th><th>Status</th><th class="text-end">View</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var cover = p.Photos.OrderByDescending(ph => ph.IsPrimary).FirstOrDefault()?.FileName;
                        <tr>
                            <td><input type="checkbox" name="listingIds" value="@p.Id" class="form-check-input" /></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@Helper.ResolvePhotoUrl(cover, "properties")" class="rounded" style="width:52px;height:40px;object-fit:cover" />
                                    <div>
                                        <div class="fw-semibold small">@p.Title</div>
                                        <div class="small text-muted">@p.PropertyType</div>
                                    </div>
                                </div>
                            </td>
                            <td class="small">@p.Host.FullName</td>
                            <td class="small">@p.City, @p.State</td>
                            <td class="small fw-semibold">@Helper.FormatMoney(p.BaseNightlyRate)</td>
                            <td class="small">@p.Bookings.Count</td>
                            <td class="small">★ @(p.ReviewCount > 0 ? p.AverageRating.ToString("0.0") : "New")</td>
                            <td><span class="sn-status @(p.IsActive ? "sn-status-Verified" : "sn-status-Cancelled")">@(p.IsActive ? "Published" : "Suspended")</span></td>
                            <td class="text-end">
                                <a asp-controller="Property" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm sn-btn-ghost">Inspect</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>
