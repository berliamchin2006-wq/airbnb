@model List<User>
@{
    ViewData["Title"] = "User & Identity Verification Console";
}
<div class="container-xl py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <span class="sn-eyebrow">Module 8 · Identity Moderation</span>
            <h2 class="fw-bold mt-1 mb-0">Users, Lockouts &amp; Identity Verification</h2>
        </div>
        <form method="get" class="d-flex gap-2">
            <input name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search name/email..." />
            <select name="role" class="form-select form-select-sm" style="width:auto">
                <option value="">All Roles</option>
                <option value="Guest" selected="@((string?)ViewBag.Role == "Guest")">Guest</option>
                <option value="Host" selected="@((string?)ViewBag.Role == "Host")">Host</option>
                <option value="Admin" selected="@((string?)ViewBag.Role == "Admin")">Admin</option>
            </select>
            <button type="submit" class="btn sn-btn-dark btn-sm">Filter</button>
        </form>
    </div>

    <form asp-action="BatchUserAction" method="post" class="sn-card p-4">
        @Html.AntiForgeryToken()
        <div class="d-flex flex-wrap align-items-center gap-2 pb-3 mb-3 border-bottom">
            <span class="small fw-semibold text-muted">Batch Admin Action:</span>
            <select name="actionType" class="form-select form-select-sm" style="width:auto">
                <option value="verify">Approve Identity (Verified)</option>
                <option value="unlock">Unlock / Reactivate Accounts</option>
                <option value="suspend">Suspend Selected Accounts</option>
            </select>
            <button type="submit" class="btn sn-btn-primary btn-sm">Run Batch Action</button>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="small text-muted">
                    <tr><th></th><th>User</th><th>Role</th><th>Email / Status</th><th>ID Verification</th><th>Bank Encrypted</th><th class="text-end">Moderation</th></tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        bool locked = u.LockoutEnd.HasValue && u.LockoutEnd.Value > DateTime.Now;
                        <tr>
                            <td><input type="checkbox" name="userIds" value="@u.Id" class="form-check-input" /></td>
                            <td class="small">
                                <div class="fw-semibold">@u.FullName</div>
                                <div class="text-muted">@u.Email · @u.PhoneNumber</div>
                            </td>
                            <td><span class="sn-role-badge">@u.Role</span></td>
                            <td class="small">
                                @(u.IsEmailVerified ? "Verified" : "Unverified") ·
                                @if (!u.IsActive) { <span class="text-danger fw-bold">Suspended</span> }
                                else if (locked) { <span class="text-danger fw-bold">Locked Out</span> }
                                else { <span class="text-success">Active</span> }
                            </td>
                            <td>
                                <span class="sn-status sn-status-@u.IdentityStatus">@u.IdentityStatus</span>
                                @if (!string.IsNullOrEmpty(u.IdDocumentPhoto))
                                {
                                    <a href="@Helper.ResolvePhotoUrl(u.IdDocumentPhoto, "documents")" target="_blank" class="small ms-1">View Doc</a>
                                }
                            </td>
                            <td class="small">@(!string.IsNullOrEmpty(u.BankAccountNumberEncrypted) ? "AES-256 ✓" : "-")</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    @if (u.IdentityStatus == "PendingApproval")
                                    {
                                        <button type="submit" formaction="@Url.Action("VerifyIdentity", "Security", new { id = u.Id, decision = "Verified" })" class="btn btn-sm btn-success">Approve ID</button>
                                        <button type="submit" formaction="@Url.Action("VerifyIdentity", "Security", new { id = u.Id, decision = "Rejected" })" class="btn btn-sm btn-outline-danger">Reject</button>
                                    }
                                    @if (locked || !u.IsActive)
                                    {
                                        <button type="submit" formaction="@Url.Action("UnlockUser", "Security", new { id = u.Id })" class="btn btn-sm btn-outline-primary">Unlock</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>
