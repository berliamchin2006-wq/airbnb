@model List<Booking>
@inject Helper Helper
@{
    ViewData["Title"] = "In-Stay & Operations Hub";
    string role = Helper.GetCurrentUserRole();
    var arrivalsSoon = ViewBag.ArrivalsSoon as List<Booking> ?? [];
    var departuresSoon = ViewBag.DeparturesSoon as List<Booking> ?? [];
}
<div class="container-xl py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <span class="sn-eyebrow">Module 5 · In-Stay &amp; Operations</span>
            <h2 class="fw-bold mt-1 mb-0">Active Stays, Check-In &amp; Guest Services</h2>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="ServiceRequests" class="btn sn-btn-ghost btn-sm"><i class="bi bi-tools me-1"></i>Service Requests</a>
            <a asp-action="Notifications" class="btn sn-btn-ghost btn-sm"><i class="bi bi-bell me-1"></i>Notifications</a>
            @if (role is "Host" or "Admin")
            {
                <a asp-action="QrScanner" class="btn sn-btn-dark btn-sm"><i class="bi bi-qr-code-scan me-1"></i>QR Scanner</a>
                <form asp-action="SendUpcomingReminders" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn sn-btn-primary btn-sm"><i class="bi bi-envelope-paper me-1"></i>Send Arrival/Departure Reminders</button>
                </form>
            }
        </div>
    </div>

    <!-- Arrival / Departure Operational Alerts -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="sn-card p-3">
                <h6 class="fw-bold mb-2"><i class="bi bi-airplane-engines text-primary me-2"></i>Upcoming Arrivals (@arrivalsSoon.Count)</h6>
                @if (!arrivalsSoon.Any())
                {
                    <div class="small text-muted">No arrivals scheduled in the next 3 days.</div>
                }
                else
                {
                    @foreach (var a in arrivalsSoon)
                    {
                        <div class="sn-soft-box p-2 px-3 small mb-2 d-flex justify-content-between align-items-center">
                            <div><strong>@a.Property.Title</strong><div class="text-muted">@a.Guest.FullName · @a.CheckInDate.ToString("dd MMM yyyy")</div></div>
                            <span class="sn-status sn-status-Confirmed">Arriving</span>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="col-md-6">
            <div class="sn-card p-3">
                <h6 class="fw-bold mb-2"><i class="bi bi-box-arrow-right text-warning me-2"></i>Upcoming Departures (@departuresSoon.Count)</h6>
                @if (!departuresSoon.Any())
                {
                    <div class="small text-muted">No check-outs scheduled in the next 48 hours.</div>
                }
                else
                {
                    @foreach (var d in departuresSoon)
                    {
                        <div class="sn-soft-box p-2 px-3 small mb-2 d-flex justify-content-between align-items-center">
                            <div><strong>@d.Property.Title</strong><div class="text-muted">@d.Guest.FullName · Out @d.CheckOutDate.ToString("dd MMM yyyy")</div></div>
                            <span class="sn-status sn-status-CheckedIn">Departing</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Active & Confirmed Stays List -->
    <div class="row g-3">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="sn-card p-5 text-center">
                    <i class="bi bi-door-closed display-5 text-muted"></i>
                    <h5 class="fw-bold mt-3">No active or upcoming stays right now</h5>
                    <a asp-controller="Property" asp-action="Catalog" class="btn sn-btn-primary btn-sm mt-2">Explore Properties</a>
                </div>
            </div>
        }
        @foreach (var b in Model)
        {
            <div class="col-lg-6">
                <div class="sn-card p-4 h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="small font-monospace text-muted">@b.BookingReference</span>
                            <h5 class="fw-bold mb-0">@b.Property.Title</h5>
                        </div>
                        <span class="sn-status sn-status-@b.Status">@b.Status</span>
                    </div>
                    <div class="small text-muted mb-3">
                        <i class="bi bi-person me-1"></i>Guest: <strong>@b.Guest.FullName</strong> ·
                        <i class="bi bi-calendar3 ms-2 me-1"></i>@b.CheckInDate.ToString("dd MMM") → @b.CheckOutDate.ToString("dd MMM yyyy")
                    </div>
                    <div class="sn-soft-box p-2 px-3 small mb-3 d-flex justify-content-between">
                        <span>Open Requests: <strong>@b.ServiceRequests.Count(s => s.Status != "Resolved")</strong></span>
                        <span>Messages: <strong>@b.Messages.Count</strong></span>
                        <span>QR Code: <code>@b.QrCheckInToken</code></span>
                    </div>
                    <div class="mt-auto d-flex flex-wrap gap-2">
                        @if (b.Status == "Confirmed")
                        {
                            <form asp-action="CheckIn" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookingId" value="@b.Id" />
                                <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check2-circle me-1"></i>Check In</button>
                            </form>
                            <a asp-controller="Booking" asp-action="CheckInPass" asp-route-id="@b.Id" class="btn sn-btn-dark btn-sm"><i class="bi bi-qr-code me-1"></i>QR Pass</a>
                        }
                        @if (b.Status == "CheckedIn")
                        {
                            <form asp-action="CheckOut" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookingId" value="@b.Id" />
                                <button type="submit" class="btn sn-btn-primary btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Check Out</button>
                            </form>
                        }
                        <a asp-action="Chat" asp-route-id="@b.Id" class="btn sn-btn-ghost btn-sm"><i class="bi bi-chat-dots me-1"></i>Real-Time Chat</a>
                        <a asp-action="ServiceRequests" asp-route-bookingId="@b.Id" class="btn sn-btn-ghost btn-sm"><i class="bi bi-tools me-1"></i>Requests</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
