@model Booking
@inject Helper Helper
@{
    ViewData["Title"] = $"In-Stay Chat — {Model.BookingReference}";
    int myId = Helper.GetCurrentUserId() ?? 0;
}
<div class="container-xl py-4" style="max-width:820px">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <span class="sn-eyebrow">Module 5 · Real-Time SignalR Chat</span>
            <h4 class="fw-bold mt-1 mb-0">@Model.Property.Title (@Model.BookingReference)</h4>
            <div class="small text-muted">Guest: @Model.Guest.FullName · Host: @Model.Property.Host.FullName</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span id="connStatus" class="badge bg-warning text-dark">Connecting...</span>
            <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.Id" class="btn sn-btn-ghost btn-sm">Booking</a>
        </div>
    </div>

    <div class="sn-card p-3 p-md-4">
        <div id="chatBox" class="sn-chat-box mb-3">
            @foreach (var m in Model.Messages.OrderBy(x => x.SentAt))
            {
                bool mine = m.SenderId == myId;
                <div class="sn-bubble @(mine ? "sn-bubble-me" : "sn-bubble-them")">
                    <div class="small fw-semibold mb-1" style="opacity:.85">@m.Sender.FullName · @m.SentAt.ToString("dd MMM, hh:mm tt")</div>
                    <div>@m.MessageText</div>
                </div>
            }
        </div>

        <form id="chatForm" asp-action="SendMessage" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="bookingId" value="@Model.Id" />
            <input type="text" id="chatInput" name="messageText" class="form-control" placeholder="Type a live message to your @(myId == Model.GuestId ? "host" : "guest")..." autocomplete="off" required />
            <button type="submit" class="btn sn-btn-primary px-4" aria-label="Send message"><i class="bi bi-send-fill" aria-hidden="true"></i></button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script>
        const bookingId = @Model.Id;
        const myId = @myId;
        const chatBox = document.getElementById('chatBox');
        chatBox.scrollTop = chatBox.scrollHeight;

        const conn = new signalR.HubConnectionBuilder()
            .withUrl('/hubs/stay')
            .withAutomaticReconnect()
            .build();

        conn.on('ReceiveBookingMessage', msg => {
            const mine = msg.senderId === myId;
            const div = document.createElement('div');
            div.className = `sn-bubble ${mine ? 'sn-bubble-me' : 'sn-bubble-them'}`;
            div.innerHTML = `<div class="small fw-semibold mb-1" style="opacity:.85">${msg.senderName} · ${msg.sentAt}</div><div></div>`;
            div.lastElementChild.textContent = msg.messageText;
            chatBox.appendChild(div);
            chatBox.scrollTop = chatBox.scrollHeight;
        });

        let hubReady = false;
        conn.start().then(() => {
            hubReady = true;
            const badge = document.getElementById('connStatus');
            badge.className = 'badge bg-success';
            badge.textContent = 'Live Connected';
            conn.invoke('JoinBookingRoom', bookingId);
        }).catch(() => {
            document.getElementById('connStatus').textContent = 'Standard Mode';
        });

        document.getElementById('chatForm')?.addEventListener('submit', async e => {
            if (!hubReady) return; // fallback to regular MVC POST
            e.preventDefault();
            const inp = document.getElementById('chatInput');
            const text = inp.value.trim();
            if (!text) return;
            await conn.invoke('SendBookingMessage', bookingId, text);
            inp.value = '';
        });
    </script>
}
