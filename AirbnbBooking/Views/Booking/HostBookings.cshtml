@model List<Booking>
@inject Helper Helper
@{
    ViewData["Title"] = "Host Reservations";
    string sel = ViewBag.SelectedStatus ?? "All";
}
<div class="container-xl py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <span class="sn-eyebrow">Module 3 · Host Reservations</span>
            <h2 class="fw-bold mt-1 mb-0">Guest Bookings</h2>
        </div>
        <div class="d-flex flex-wrap gap-1">
            @foreach (var st in new[] { "All", "Pending", "Confirmed", "CheckedIn", "Completed", "Cancelled" })
            {
                <a asp-action="HostBookings" asp-route-status="@st" class="btn btn-sm @(sel == st ? "sn-btn-dark" : "sn-btn-ghost")">@st</a>
            }
        </div>
    </div>

    <div class="sn-card p-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="small text-muted">
                    <tr>
                        <th>Ref</th>
                        <th>Guest</th>
                        <th>Property</th>
                        <th>Stay Dates</th>
                        <th>Guest Total</th>
                        <th>Host Net</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td class="font-monospace small fw-semibold">@b.BookingReference</td>
                            <td class="small">
                                <div class="fw-semibold">@b.Guest.FullName</div>
                                <div class="text-muted">@b.Guest.PhoneNumber</div>
                            </td>
                            <td class="small fw-medium">@b.Property.Title</td>
                            <td class="small">@b.CheckInDate.ToString("dd MMM") – @b.CheckOutDate.ToString("dd MMM yyyy") (@b.TotalNights n)</td>
                            <td class="small fw-semibold">@Helper.FormatMoney(b.TotalAmount)</td>
                            <td class="small text-success fw-semibold">@(b.HostPayout != null ? Helper.FormatMoney(b.HostPayout.NetPayoutAmount) : "-")</td>
                            <td><span class="sn-status sn-status-@b.Status">@b.Status</span></td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm sn-btn-ghost">View</a>
                                    <a asp-controller="Stay" asp-action="Chat" asp-route-id="@b.Id" class="btn btn-sm sn-btn-ghost" title="Chat"><i class="bi bi-chat-dots"></i></a>
                                    @if (b.Status == "Completed" && b.Review?.HostSubmittedAt == null)
                                    {
                                        <a asp-controller="Review" asp-action="WriteHostReview" asp-route-bookingId="@b.Id" class="btn btn-sm sn-btn-primary">Rate Guest</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
