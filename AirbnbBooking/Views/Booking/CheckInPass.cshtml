@model Booking
@{
    ViewData["Title"] = $"QR Check-In Pass — {Model.BookingReference}";
}
<div class="container-xl py-4">
    <div class="sn-card p-4 p-md-5 mx-auto text-center" style="max-width:520px">
        <span class="sn-eyebrow">Digital Check-In Pass</span>
        <h3 class="fw-bold mt-2 mb-1">@Model.Property.Title</h3>
        <p class="small text-muted mb-4">@Model.Property.Address, @Model.Property.City</p>

        <div class="sn-soft-box p-4 d-inline-block mb-3">
            <div id="qrCanvas"></div>
        </div>

        <div class="font-monospace fw-bold fs-5 mb-1">@Model.QrCheckInToken</div>
        <div class="small text-muted mb-4">Booking Reference: <strong>@Model.BookingReference</strong></div>

        <div class="row g-2 text-start small sn-soft-box p-3 mb-4">
            <div class="col-6"><span class="text-muted d-block">Guest</span><strong>@Model.Guest.FullName</strong></div>
            <div class="col-6"><span class="text-muted d-block">Status</span><span class="sn-status sn-status-@Model.Status">@Model.Status</span></div>
            <div class="col-6"><span class="text-muted d-block">Check-In</span><strong>@Model.CheckInDate.ToString("dd MMM yyyy") (3:00 PM)</strong></div>
            <div class="col-6"><span class="text-muted d-block">Check-Out</span><strong>@Model.CheckOutDate.ToString("dd MMM yyyy") (11:00 AM)</strong></div>
        </div>

        <div class="d-flex justify-content-center gap-2 no-print">
            <button type="button" onclick="window.print()" class="btn sn-btn-dark btn-sm"><i class="bi bi-printer me-1"></i>Print / Save PDF</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn sn-btn-ghost btn-sm">Back to Booking</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        new QRCode(document.getElementById('qrCanvas'), {
            text: '@Model.QrCheckInToken',
            width: 210,
            height: 210,
            colorDark: '#111827',
            colorLight: '#ffffff',
            correctLevel: QRCode.CorrectLevel.H
        });
    </script>
}
