@model Booking
@{
    ViewData["Title"] = $"E-Receipt {Model.BookingReference}";
    var latestPayment = Model.Payments.OrderByDescending(p => p.PaymentDate).FirstOrDefault();
}
<div class="container-xl py-4" style="max-width:780px">
    <div class="d-flex justify-content-between align-items-center mb-3 no-print">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn sn-btn-ghost btn-sm">← Back to Booking</a>
        <div class="d-flex gap-2">
            <a asp-action="CheckInPass" asp-route-id="@Model.Id" class="btn sn-btn-ghost btn-sm"><i class="bi bi-qr-code me-1"></i>QR Pass</a>
            <button type="button" onclick="window.print()" class="btn sn-btn-primary btn-sm"><i class="bi bi-file-earmark-pdf me-1"></i>Print / Save PDF E-Receipt</button>
        </div>
    </div>

    <div class="sn-card p-4 p-md-5">
        <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="sn-brand-mark sn-brand-mark-sm"><i class="bi bi-house-heart-fill"></i></span>
                    <h4 class="fw-bold mb-0">StayNest Airbnb</h4>
                </div>
                <div class="small text-muted">Official Electronic Payment Receipt</div>
            </div>
            <div class="text-end small">
                <div class="fw-bold fs-6">@Model.BookingReference</div>
                <div class="text-muted">Issued: @DateTime.Now.ToString("dd MMM yyyy HH:mm")</div>
                <span class="sn-status sn-status-@Model.Status mt-1">@Model.Status</span>
            </div>
        </div>

        <div class="row g-3 small mb-4">
            <div class="col-md-6">
                <div class="text-muted text-uppercase fw-semibold" style="font-size:.72rem">Billed To</div>
                <div class="fw-bold">@Model.Guest.FullName</div>
                <div>@Model.Guest.Email · @Model.Guest.PhoneNumber</div>
            </div>
            <div class="col-md-6 text-md-end">
                <div class="text-muted text-uppercase fw-semibold" style="font-size:.72rem">Property &amp; Host</div>
                <div class="fw-bold">@Model.Property.Title</div>
                <div>@Model.Property.City, @Model.Property.State · Host: @Model.Property.Host.FullName</div>
            </div>
        </div>

        <table class="table table-bordered small mb-4">
            <thead class="table-light">
                <tr><th>Description</th><th class="text-end">Amount (MYR)</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td>Accommodation (@Model.CheckInDate.ToString("dd MMM yyyy") – @Model.CheckOutDate.ToString("dd MMM yyyy"), @Model.TotalNights nights × avg RM @Model.AverageNightlyRate.ToString("N2"))</td>
                    <td class="text-end">RM @Model.SubtotalAmount.ToString("N2")</td>
                </tr>
                <tr><td>Cleaning &amp; Turnover Fee</td><td class="text-end">RM @Model.CleaningFee.ToString("N2")</td></tr>
                <tr><td>Platform Service Tax (10%)</td><td class="text-end">RM @Model.ServiceTax.ToString("N2")</td></tr>
                @if (Model.DiscountAmount > 0)
                {
                    <tr class="text-success"><td>Promo Code (@Model.PromoCode?.Code)</td><td class="text-end">-RM @Model.DiscountAmount.ToString("N2")</td></tr>
                }
                <tr class="fw-bold fs-6">
                    <td>Total Charged</td>
                    <td class="text-end">RM @Model.TotalAmount.ToString("N2")</td>
                </tr>
            </tbody>
        </table>

        @if (latestPayment != null)
        {
            <div class="sn-soft-box p-3 small">
                <div class="row g-2">
                    <div class="col-md-4"><span class="text-muted d-block">Transaction Reference</span><strong class="font-monospace">@latestPayment.TransactionRef</strong></div>
                    <div class="col-md-4"><span class="text-muted d-block">Payment Method</span><strong>@latestPayment.PaymentMethod</strong></div>
                    <div class="col-md-4"><span class="text-muted d-block">Paid On</span><strong>@latestPayment.PaymentDate.ToString("dd MMM yyyy HH:mm")</strong></div>
                </div>
                @if (latestPayment.RefundAmount > 0)
                {
                    <div class="text-danger mt-2 pt-2 border-top">
                        <strong>Refund Processed:</strong> RM @latestPayment.RefundAmount.ToString("N2") (@latestPayment.RefundReason)
                    </div>
                }
            </div>
        }
    </div>
</div>
