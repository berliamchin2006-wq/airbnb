@model Booking
@inject Helper Helper
@{
    ViewData["Title"] = $"Reservation {Model.BookingReference}";
    var refundPreview = ViewBag.RefundPreview as RefundCalculationResult;
    string[] steps = ["Pending", "Confirmed", "CheckedIn", "Completed"];
    int activeIdx = Array.IndexOf(steps, Model.Status);
}
<div class="container-xl py-4" style="max-width:980px">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <span class="sn-eyebrow">Booking @Model.BookingReference</span>
            <h2 class="fw-bold mt-1 mb-0">@Model.Property.Title</h2>
        </div>
        <span class="sn-status sn-status-@Model.Status fs-6">@Model.Status</span>
    </div>

    <!-- Reservation State Machine Stepper -->
    @if (Model.Status != "Cancelled")
    {
        <div class="sn-card p-3 p-md-4 mb-4">
            <div class="row text-center g-2">
                @for (int i = 0; i < steps.Length; i++)
                {
                    bool done = i <= activeIdx;
                    <div class="col-3">
                        <div class="rounded-circle mx-auto mb-1 d-flex align-items-center justify-content-center fw-bold"
                             style="width:34px;height:34px;background:@(done ? "var(--sn-accent)" : "var(--sn-surface-soft)");color:@(done ? "#fff" : "var(--sn-muted)")">
                            @(done ? "✓" : (i + 1).ToString())
                        </div>
                        <div class="small @(done ? "fw-bold" : "text-muted")">@steps[i]</div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="sn-card p-4 mb-4">
                <h5 class="fw-bold mb-3">Stay &amp; Guest Summary</h5>
                <div class="row g-3 small">
                    <div class="col-6"><span class="text-muted d-block">Check-In</span><strong>@Model.CheckInDate.ToString("ddd, dd MMM yyyy")</strong></div>
                    <div class="col-6"><span class="text-muted d-block">Check-Out</span><strong>@Model.CheckOutDate.ToString("ddd, dd MMM yyyy")</strong></div>
                    <div class="col-6"><span class="text-muted d-block">Guest</span><strong>@Model.Guest.FullName (@Model.GuestCount guests)</strong></div>
                    <div class="col-6"><span class="text-muted d-block">Host</span><strong>@Model.Property.Host.FullName (@Model.Property.Host.PhoneNumber)</strong></div>
                    <div class="col-12"><span class="text-muted d-block">Address</span><strong>@Model.Property.Address, @Model.Property.City, @Model.Property.State</strong></div>
                    @if (!string.IsNullOrEmpty(Model.SpecialRequests))
                    {
                        <div class="col-12"><span class="text-muted d-block">Special Requests</span>@Model.SpecialRequests</div>
                    }
                    @if (Model.CheckedInAt.HasValue)
                    {
                        <div class="col-6"><span class="text-muted d-block">Actual Check-In</span><strong class="text-success">@Model.CheckedInAt.Value.ToString("dd MMM yyyy HH:mm")</strong></div>
                    }
                    @if (Model.CheckedOutAt.HasValue)
                    {
                        <div class="col-6"><span class="text-muted d-block">Actual Check-Out</span><strong>@Model.CheckedOutAt.Value.ToString("dd MMM yyyy HH:mm")</strong></div>
                    }
                </div>

                <!-- Action Controls -->
                <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
                    @if (Model.Status == "Pending" && Helper.IsOwnerOrAdmin(Model.GuestId))
                    {
                        <a asp-controller="Payment" asp-action="Checkout" asp-route-bookingId="@Model.Id" class="btn sn-btn-primary btn-sm">Pay Now</a>
                    }
                    @if (Model.Status == "Confirmed")
                    {
                        <a asp-action="CheckInPass" asp-route-id="@Model.Id" class="btn sn-btn-dark btn-sm"><i class="bi bi-qr-code me-1"></i>QR Check-In Pass</a>
                        <form asp-controller="Stay" asp-action="CheckIn" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId" value="@Model.Id" />
                            <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-door-open me-1"></i>Mark Checked In</button>
                        </form>
                    }
                    @if (Model.Status == "CheckedIn")
                    {
                        <form asp-controller="Stay" asp-action="CheckOut" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId" value="@Model.Id" />
                            <button type="submit" class="btn sn-btn-primary btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Complete Check-Out</button>
                        </form>
                    }
                    <a asp-action="Receipt" asp-route-id="@Model.Id" class="btn sn-btn-ghost btn-sm"><i class="bi bi-receipt me-1"></i>PDF E-Receipt</a>
                    <a asp-controller="Stay" asp-action="Chat" asp-route-id="@Model.Id" class="btn sn-btn-ghost btn-sm"><i class="bi bi-chat-dots me-1"></i>Live Chat</a>
                    <a asp-controller="Stay" asp-action="ServiceRequests" asp-route-bookingId="@Model.Id" class="btn sn-btn-ghost btn-sm"><i class="bi bi-tools me-1"></i>Service Requests (@Model.ServiceRequests.Count)</a>
                </div>
            </div>

            <!-- Cancellation & Automated Policy Refund Box -->
            @if (Model.Status is "Pending" or "Confirmed")
            {
                <div class="sn-card p-4 border-danger-subtle">
                    <h6 class="fw-bold text-danger mb-1"><i class="bi bi-x-circle me-1"></i>Cancellation Policy: @Model.Property.CancellationPolicy</h6>
                    @if (refundPreview != null)
                    {
                        <p class="small text-muted mb-3">
                            @refundPreview.Explanation
                            <strong class="d-block text-body mt-1">Estimated Refund Today: @Helper.FormatMoney(refundPreview.RefundAmount) (@refundPreview.RefundPercent%)</strong>
                        </p>
                    }
                    <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this reservation and process the calculated refund?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="input-group input-group-sm">
                            <input type="text" name="reason" class="form-control" placeholder="Reason for cancellation (optional)" />
                            <button type="submit" class="btn btn-outline-danger">Cancel Booking</button>
                        </div>
                    </form>
                </div>
            }
        </div>

        <!-- Right Column: Itemized Price Breakdown & Payments -->
        <div class="col-lg-5">
            <div class="sn-card p-4">
                <h5 class="fw-bold mb-3">Price Breakdown</h5>
                <div class="small">
                    <div class="d-flex justify-content-between mb-2">
                        <span>@Model.TotalNights night(s) × avg @Helper.FormatMoney(Model.AverageNightlyRate)</span>
                        <span>@Helper.FormatMoney(Model.SubtotalAmount)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Cleaning fee</span>
                        <span>@Helper.FormatMoney(Model.CleaningFee)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Platform service tax (10%)</span>
                        <span>@Helper.FormatMoney(Model.ServiceTax)</span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Promo (@Model.PromoCode?.Code)</span>
                            <span>-@Helper.FormatMoney(Model.DiscountAmount)</span>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between fs-5 fw-bold">
                        <span>Total</span>
                        <span>@Helper.FormatMoney(Model.TotalAmount)</span>
                    </div>
                </div>

                @if (Model.Payments.Any())
                {
                    <div class="mt-4 pt-3 border-top">
                        <h6 class="fw-bold small mb-2">Payment Records</h6>
                        @foreach (var pay in Model.Payments)
                        {
                            <div class="sn-soft-box p-2 px-3 small mb-2">
                                <div class="d-flex justify-content-between fw-semibold">
                                    <span>@pay.TransactionRef</span>
                                    <span class="sn-status sn-status-@pay.Status">@pay.Status</span>
                                </div>
                                <div class="text-muted">@pay.PaymentMethod · @pay.PaymentDate.ToString("dd MMM yyyy HH:mm")</div>
                                @if (pay.RefundAmount > 0)
                                {
                                    <div class="text-danger mt-1">Refunded: @Helper.FormatMoney(pay.RefundAmount) — @pay.RefundReason</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
