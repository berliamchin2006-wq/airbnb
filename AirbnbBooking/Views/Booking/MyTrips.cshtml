@model List<Booking>
@inject Helper Helper
@{
    ViewData["Title"] = "My Trips";
    string sel = ViewBag.SelectedStatus ?? "All";
}
<div class="container-xl py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <span class="sn-eyebrow">Module 3 · Reservations</span>
            <h2 class="fw-bold mt-1 mb-0">My Trips</h2>
        </div>
        <div class="d-flex flex-wrap gap-1">
            @foreach (var st in new[] { "All", "Pending", "Confirmed", "CheckedIn", "Completed", "Cancelled" })
            {
                <a asp-action="MyTrips" asp-route-status="@st" class="btn btn-sm @(sel == st ? "sn-btn-dark" : "sn-btn-ghost")">@st</a>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="sn-card p-5 text-center">
            <i class="bi bi-suitcase-lg display-5 text-muted"></i>
            <h5 class="fw-bold mt-3">No trips in this category</h5>
            <a asp-controller="Property" asp-action="Catalog" class="btn sn-btn-primary btn-sm mt-2">Explore Stays</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var b in Model)
            {
                var cover = b.Property.Photos.OrderByDescending(ph => ph.IsPrimary).FirstOrDefault()?.FileName;
                <div class="col-12">
                    <div class="sn-card p-3 p-md-4">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-3">
                                <img src="@Helper.ResolvePhotoUrl(cover, "properties")" class="w-100 rounded-3" style="height:135px;object-fit:cover" />
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="sn-status sn-status-@b.Status">@b.Status</span>
                                    <span class="small font-monospace text-muted">@b.BookingReference</span>
                                </div>
                                <h5 class="fw-bold mb-1">
                                    <a asp-action="Details" asp-route-id="@b.Id" class="text-reset text-decoration-none">@b.Property.Title</a>
                                </h5>
                                <div class="small text-muted mb-2">
                                    <i class="bi bi-calendar3 me-1"></i>@b.CheckInDate.ToString("dd MMM yyyy") → @b.CheckOutDate.ToString("dd MMM yyyy")
                                    (@b.TotalNights nights · @b.GuestCount guests)
                                </div>
                                <div class="fw-bold">@Helper.FormatMoney(b.TotalAmount)</div>
                            </div>
                            <div class="col-md-3 d-flex flex-column gap-2">
                                @if (b.Status == "Pending")
                                {
                                    <a asp-controller="Payment" asp-action="Checkout" asp-route-bookingId="@b.Id" class="btn sn-btn-primary btn-sm">Complete Payment</a>
                                }
                                @if (b.Status is "Confirmed" or "CheckedIn")
                                {
                                    <a asp-action="CheckInPass" asp-route-id="@b.Id" class="btn sn-btn-dark btn-sm"><i class="bi bi-qr-code me-1"></i>QR Check-In Pass</a>
                                    <a asp-controller="Stay" asp-action="Chat" asp-route-id="@b.Id" class="btn sn-btn-ghost btn-sm"><i class="bi bi-chat-dots me-1"></i>Live Chat</a>
                                }
                                @if (b.Status == "Completed" && b.Review?.GuestSubmittedAt == null)
                                {
                                    <a asp-controller="Review" asp-action="WriteGuestReview" asp-route-bookingId="@b.Id" class="btn sn-btn-primary btn-sm"><i class="bi bi-star me-1"></i>Write Review</a>
                                }
                                <a asp-action="Details" asp-route-id="@b.Id" class="btn sn-btn-ghost btn-sm">Details &amp; Receipt</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
